% x_udf_test.pi -- YOUR-OWN functions inside constraint expressions (udf).
%
% VERY EXPERIMENTAL: the `udf` module (lib/udf.pi) lets you use your own
% functions inside constraint expressions, which is NOT an official Picat
% feature (the built-in #= etc. only accept the set of arithmetic
% function symbols).  Several pieces of the syntax are not final: the user
% function is registered as a TERM (hence the `$` in `$inc(X)`), and
% the constraint operators are redefined by a per-solver include file
% (`udf_ops.pi` for cp).  See lib/udf.pi for the details.
%
% FS requirement for this page: `import udf.` needs lib/udf.pi, and
% `include "udf_ops.pi"` needs the shims beside this file, both on the
% (virtual) file system of the wasm build.

import cp.
import udf.
include "udf_ops.pi".

main =>
    % register the user function used in constraints:
    udf.define($inc(N), $(N+1)),
    X :: 0..10,
    $inc(X) #= 6,                % inc(X) = X+1 = 6  ->  X = 5
    solve([X]),
    println(X),                    % 5
    println(udf.evaluate($inc(X))).   % 6
