% x_asp_queens.pi -- VERY EXPERIMENTAL.
%
% This is the 8-queens problem written in ASP, embedded directly in a
% Picat program, and transpiled at run time by aspic, which is not
% part of Picat; the aspic sources used here are preloaded from the
% lib_ext repository, aspic/ (https://github.com/picat-lang/lib_ext,
% main branch).  The page runs it in two stages: a pre-translation
% pass (aspic_prep) rewrites this file into plain Picat plus the
% aspic runtime, then a fresh interpreter runs the result.
%
% The embedded ASP defaults to the built-in SAT backend.  On this
% 32-bit (wasm) build that backend's clause arena is capped at 1 GB,
% so large instances (roughly N >= 180 in this encoding) must be
% switched to the picat constraint solver with a file-level hack
% line outside the asp block:
%
%     #constr cp
%
% (A cleaner mechanism would be to interpret "import cp." or
% "import sat." in the Picat way, but the hack will do for now.)

import aspic_runtime.

pp(A)=>foreach(X in A) println(X) end,println(-----------------------------------).
#define DIM 8
main=>N=DIM,asp
#const n = DIM.
% n-Queens encoding
{ q(I,1..n) } == 1 :- I = 1..n.
{ q(1..n,J) } == 1 :- J = 1..n.
:- { q(D-J,J) } >= 2, D = 2..2*n.
:- { q(D+J,J) } >= 2, D = 1-n..n-1.
end,
aspic_solve_sub(0),
pp([[q(I,J):J in 1..N]:I in 1..N])
.

