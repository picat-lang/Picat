% picat-fdn transparency tests: each block prints solutions / counts and the
% backtracks statistic, which must be identical to stock Picat.
import cp, util.

main =>
    % binary and n-ary linear, ARC sums on non-0/1 variables
    L1 = findall(Q, (Q=new_list(6), Q::1..6, all_distinct(Q), Q[1] #> Q[2], sum(Q) #= 21, solve(Q))),
    println(t1=[len(L1), slice(L1,1,3)]),
    L2 = findall([X,Y,Z], ([X,Y,Z]::0..9, X+Y #= 9, X #= Z+2, 3*X+2*Y-Z #>= 10, solve([ff],[X,Y,Z]))),
    println(t2=L2),
    % send more money (alldifferent + big linear)
    Vs = [S,E,N,D,M,O,R,Y2], Vs :: 0..9, all_different(Vs), S #> 0, M #> 0,
    1000*S+100*E+10*N+D + 1000*M+100*O+10*R+E #= 10000*M+1000*O+100*N+10*E+Y2,
    solve(Vs), println(t3=Vs),
    % magic square 3x3 (all_distinct permutation + sums), count all
    C = count_all(magic(3)), println(t4=C),
    % ff on alldifferent with holes, first solution, then the next two by backtracking
    L5 = findall(Ws, (Ws=new_list(5), Ws::[1,3,5,7,9,11], all_different(Ws), Ws[1]+Ws[5] #= 12, solve([ffc],Ws))),
    println(t5=[len(L5), slice(L5,1,4)]),
    % element with a constant index (binds T[2] at posting)
    T = new_list(4), T :: 1..4, all_different(T), element(2, T, 3), solve(T), println(t7=T),
    % queens via ints in the list (partially instantiated); last, see README:
    % stock Picat reports some retries of an exhausted count_all only at the
    % next solve, picat-fdn does not
    Qs = new_array(9), Qs[1] = 1, Qs :: 1..9,
    foreach (I in 1..8, J in I+1..9) Qs[I] #!= Qs[J], abs(Qs[I]-Qs[J]) #!= J-I end,
    println(t6=count_all(solve(Qs))),
    statistics(backtracks, B), println(backtracks=B),
    % unsupported propagator (circuit): falls back to Picat's labeling
    K = new_list(5), K :: 1..5, circuit(K), solve(K), println(t8=K).

magic(N) =>
    M = new_array(N,N), V = vars(M), V :: 1..N*N, all_distinct(V), S = N*(N*N+1)//2,
    foreach (I in 1..N) sum([M[I,J] : J in 1..N]) #= S, sum([M[J,I] : J in 1..N]) #= S end,
    sum([M[I,I] : I in 1..N]) #= S, sum([M[I,N+1-I] : I in 1..N]) #= S,
    solve([ff], V).
