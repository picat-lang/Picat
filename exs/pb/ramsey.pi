% ramsey: (K,K)-Ramsey graphs on N vertices, sized by the environment.
% The same program body runs unchanged under import pb, import cp and
% import sat; only the import line decides the solver.  pb sends the
% linear form to an external pseudo-Boolean solver (env PBSOL); cp and
% sat are built in.
%
% Background: R(K,K) is the least m such that every graph on m
% vertices contains a K-clique (K mutually adjacent vertices) or an
% independent K-set (K mutually non-adjacent vertices).  A graph on N
% vertices that has NEITHER is a (K,K)-Ramsey graph; it witnesses
% R(K,K) > N, and at N = R(K,K)-1 it is a (K,K)-critical graph.
%
% The program searches for a (K,K)-Ramsey/critical graph on N
% vertices:
%   SAT   -> prints the graph, independently verifies it (no K-clique
%            and no independent K-set among all C(N,K) vertex sets),
%            and notes R(K,K) >= N+1.
%   UNSAT -> no such graph exists, i.e. R(K,K) <= N (combined with a
%            (N-1)-vertex SAT run this PROVES R(K,K) = N).  Under pb a
%            fail is UNSAT: the external solver always answers.  (A
%            solver crash would be misread; the frontier runs below
%            are bounded by the shell timeout, which kills the process
%            before the fail path is reached.)
%
% Encoding: one 0/1 var per undirected edge (N*(N-1)/2 vars); for
% every K-subset S of the vertices with its C(K,2) edge vars Ev:
%     sum(Ev) #=< C(K,2)-1     S is not a K-clique
%     sum(Ev) #>= 1            S is not an independent K-set
% Symmetry breaking: vertex degrees in non-increasing order (any
% solution can be vertex-renumbered that way), removing the N!
% isomorphic labelings.  The edge and degree vars share one array so
% that the uniform solve(V) call is identical under all three imports.
%
% Default (K=3, N=6) is the classical UNSAT instance proving R(3,3)=6.
% Measured on this machine (cores 90,91; pb = roundingsat on the OPB
% encoding, cnf = kissat via the sat portfolio, same encoding):
%   K=3 N=5   SAT, the 5-cycle (the unique (3,3) graph on 5
%                      vertices):                      pb 11ms  cnf 12ms
%   K=3 N=6   UNSAT, the real proof search for R(3,3) = 6:
%                                                      pb 12ms  cnf  9ms
%   K=4 N=15  SAT, a (4,4)-Ramsey graph (R(4,4) >= 16):
%                                                      pb 1.7s   cnf 73ms
%   K=4 N=17  SAT, the extremal witness (R(4,4) >= 18), 136 edge
%             vars, 2*C(17,4) = 4760 subset constraints:
%                                                      pb 11.5s  cnf 204ms
%   K=4 N=18  R(4,4) = 18 is a proven classical result (McKay and
%             Radziszowski 1995), so this instance is UNSAT -- but its
%             proof is far beyond both paths: no verdict in 60s (a
%             frontier "watch the solvers" run, bounded by the shell
%             timeout).  R(5,5) is the famous open problem (43 <=
%             R(5,5) <= 48), and K=5 instances blow up fast.
% The verdict: on Ramsey the CNF path wins the SAT side decisively --
% finding a coloring is search-heavy, where CDCL excels.  The pb
% sweet spot remains the counting-argument UNSAT class (pigeonhole,
% where the clausal encoding is exponential and the OPB path is
% milliseconds); the K=3 UNSAT points here are comparable.
%
% With pb:   PBSOL=<solver> PICATPATH=<picat>/lib2 emu/picat ramsey.pi
%            K=4 N=15 PBSOL=<solver> PICATPATH=<picat>/lib2 emu/picat ramsey.pi
% With cp:   swap the import line, drop the env:  emu/picat ramsey.pi
%
% K defaults to 3 and N defaults to 6 when the env vars are absent; N
% must be set explicitly for K != 3.

import pb, os.

main =>
    k_from_env(K),
    n_from_env(K, N),
    M = K * (K - 1) // 2,
    NPairs = N * (N - 1) // 2,
    subsets(K, N, AllSets),
    NSets = length(AllSets),
    bp.c_wall_ms(T0),
    writef("=== ramsey: looking for a (%d,%d)-Ramsey graph on %d vertices, %d edge vars, %d K-subsets%n",
        K, K, N, NPairs, NSets),
    % one combined array: the edge vars at 1..NPairs, the degree vars after
    V = new_array(NPairs + N),
    V[1..NPairs] :: 0..1,
    V[NPairs + 1..NPairs + N] :: 0..N - 1,
    no_k_sets(N, K, M, AllSets, V),
    degree_order(N, V, NPairs),
    ( solve(V) ->
        sat_found(K, N, M, AllSets, V, NPairs, T0)
    ;
        unsat_ok(K, N, T0)
    ),
    halt.

k_from_env(K) =>
    ( os.env_exists("K") -> K = os.getenv("K").to_int ; K = 3 ),
    ( K >= 2 -> true ; throw($k_expected_at_least_2(K)) ).

n_from_env(K, N) =>
    ( os.env_exists("N") -> N = os.getenv("N").to_int
    ; K == 3 -> N = 6
    ; throw($n_env_var_expected(K)) ),
    ( N >= K -> true ; throw($n_expected_at_least_k(K, N)) ).

% 1-based array index of the edge (I,J), 0 <= I < J < N
pair_idx(I, J, N) =
    I * (N - 1) - I * (I - 1) // 2 + (J - I).

% all strictly increasing K-element subsets of {0..N-1}
subsets(K, N, All) =>
    Dom = [I : I in 0..(N - 1)],
    All = findall(S, comb(K, Dom, S)).

% comb(K, Dom, S): all K-element subsets of Dom, in increasing order
comb(0, _Dom, S) => S = [].
comb(K, [H|T], S) =>
    K > 0,
    (take_c(K, H, T, S) ; drop_c(K, T, S)).

take_c(K, H, T, S) =>
    Len = length(T),
    Len >= K - 1,
    S = [H|R],
    comb(K - 1, T, R).

drop_c(K, T, S) =>
    Len = length(T),
    Len >= K,
    comb(K, T, S).

no_k_sets(N, K, M, Sets, V) =>
    foreach (S in Sets)
        Ev = [V[pair_idx(S[P], S[Q], N)] : P in 1..K, Q in P + 1..K],
        sum(Ev) #=< M - 1,
        sum(Ev) #>= 1
    end.

% D[I] = degree of vertex I; the degree vars sit at NPairs+I+1 and the
% vertices are assumed sorted by degree (non-increasing): a valid
% symmetry breaking, since any solution can be renumbered that way.
degree_order(N, V, NPairs) =>
    foreach (I in 0..N - 1)
        Di = [V[pair_idx(J, I, N)] : J in 0..I - 1]
           ++ [V[pair_idx(I, J, N)] : J in I + 1..N - 1],
        V[NPairs + I + 1] #= sum(Di)
    end,
    foreach (I in 0..N - 2)
        V[NPairs + I + 1] #>= V[NPairs + I + 2]
    end.

sat_found(K, N, M, AllSets, V, NPairs, T0) =>
    bp.c_wall_ms(T1),
    check_graph(K, N, M, AllSets, V),
    print_graph(N, V, NPairs),
    writef("SAT: (K,K)-Ramsey/critical graph on %d vertices found in %d ms -- witnesses R(%d,%d) >= %d%n",
        N, T1 - T0, K, K, N + 1).

unsat_ok(K, N, T0) =>
    bp.c_wall_ms(T1),
    writef("UNSAT in %d ms: every graph on %d vertices has a %d-clique or an independent %d-set, i.e. R(%d,%d) <= %d%n",
        T1 - T0, N, K, K, K, K, N),
    writef("    (together with a SAT run on N-1 vertices this proves R(%d,%d) = %d)%n",
        K, K, N).

% independent re-check: no K-subset is all-edges (clique) or
% all-no-edges (independent)
check_graph(K, N, M, Sets, V) =>
    foreach (S in Sets)
        Eds = [V[pair_idx(S[P], S[Q], N)] : P in 1..K, Q in P + 1..K],
        Cnt = sum(Eds),
        ( (Cnt > 0, Cnt < M) -> true
        ; writef("CHECK FAILED: %d-subset %w has %d edges%n", K, S, Cnt),
          throw($ramsey_check_failed(S, K, N)) )
    end.

print_graph(N, V, NPairs) =>
    writef("degrees (non-increasing): %w%n", [V[NPairs + I + 1] : I in 0..N - 1]),
    writef("matrix (row = vertex, 1 = red edge):%n"),
    foreach (I in 0..N - 1)
        writef("  %d: ", I),
        foreach (J in 0..N - 1)
            ( I < J -> W = V[pair_idx(I, J, N)]
            ; I == J -> W = -1
            ; W = V[pair_idx(J, I, N)] ),
            ( W == -1 -> writef("  ") ; writef("%d ", W) )
        end,
        writef("%n")
    end.
