% evencol: the even-colouring problem.  Take a graph in which every
% vertex has even degree and the number of edges is ODD, and colour
% each edge 0/1 so that at every vertex exactly half of the
% incident edges have colour 1 -- impossible: summing the vertex
% equations counts each edge twice, so the total number of
% colour-1 edges would be |E|/2 with |E| odd.  The generator builds
% a random 4-regular simple graph on V vertices (V even, seeded LCG,
% Fisher-Yates pairing of the half-edges, retries on self-loops or
% doubled edges) and subdivides one edge with a new degree-2 vertex,
% which makes the edge count 2V+1 odd while keeping every degree
% even.  One 0/1 var per edge; for each original vertex the
% equation sum of its incident vars = 2, for the new vertex = 1.
% UNSAT.  Like pmodd the counting needs the DIVIDE rule: the
% relaxation x_e = 1/2 is feasible, so an LP solver alone cannot
% refute the instance; on expander graphs, which random 4-regular
% graphs are with high probability, resolution proofs are
% exponential (Markström 2006).  Caveat: the built-in sat and cp
% paths answer in ms too (their lowering of the equations carries
% the counting in auxiliary structure or in propagation), so the
% exponential separation shows against direct clausal encodings,
% not against the built-in solvers.
% Sized by the command line:
%   picat evencol.pi <vertices>      (V even, >= 4)
% The same program body runs unchanged under import pb, import cp
% and import sat; only the import line decides the solver.  pb sends
% the linear form to an external pseudo-Boolean solver (env PBSOL);
% cp and sat are built in.  No timing here -- the sweep script
% test/pb_families_bench.sh measures all three solvers.
%
% With pb:  PBSOL=<solver> PICATPATH=<picat>/lib2 emu/picat evencol.pi 20
% With cp:  emu/picat evencol.pi 20           (after the import swap)

import pb, os.

main([VS]) =>
    V0 = VS.to_int,
    (Eall, Vn) = gen_graph(V0),
    NE = Eall.length,
    X = new_array(NE),
    X :: 0..1,
    foreach (U in 1..Vn)
        Inc = [X[K] : K in 1..NE, Eall[K, 1] == U] ++
              [X[K] : K in 1..NE, Eall[K, 2] == U],
        Half = cond(U == Vn, 1, 2),     % the new vertex has degree 2
        sum(Inc) #= Half
    end,
    bp.c_wall_ms(T0),
    ( solve(X) ->
        bp.c_wall_ms(T1),
        printf("SAT: a half-colouring exists (%d vertices, %d edges, %d ms)%n", Vn, NE, T1 - T0)
    ;
        bp.c_wall_ms(T1),
        printf("UNSAT: no half-colouring exists (%d vertices, %d edges, %d ms)%n", Vn, NE, T1 - T0)
    ).

% a random 4-regular simple graph on V vertices, one edge subdivided
% with the new vertex V+1; returns (edges, vertex count)
gen_graph(V) = (Eall, Vn) =>
    gen_try(V, 20260501, 0, Eall, Vn).

gen_try(V, S, Attempt, Eall, Vn) ?=>
    (Hs, S1) = fisher_yates([W : W in 1..V, _K in 1..4], S),
    Es = [edge_norm(Hs[2 * K - 1], Hs[2 * K]) : K in 1..2 * V],
    ( simple(Es) ->
        Es[1] = [A, B],
        Eall = [[A, V + 1], [V + 1, B] | Es[2..Es.length]],
        Vn = V + 1
    ;
        Attempt > 200 -> throw($no_graph)
    ;
        gen_try(V, lcg(S1), Attempt + 1, Eall, Vn)
    ).

lcg(S) = (6364136223846793005 * S + 1442695040888963407) mod 18446744073709551616.

% Fisher-Yates shuffle of the list L with the LCG; returns (array, state)
fisher_yates(L, S0) = (A, S) =>
    N = L.length,
    A = new_array(N),
    foreach (I in 1..N)
        A[I] := L[I]
    end,
    S := S0,
    foreach (I in N..-1..2)
        S := lcg(S),
        J = 1 + S mod I,
        T = A[I], A[I] := A[J], A[J] := T
    end.

edge_norm(A, B) = cond(A < B, [A, B], [B, A]).

% no self-loops, no doubled edges
simple(Es) =>
    foreach (E in Es)
        E[1] != E[2]
    end,
    Es.length == Es.remove_dups().length.
