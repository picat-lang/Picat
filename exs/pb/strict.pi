% Strict relations over sums, variables on both sides.  Integrality
% makes the shift exact:  L < R  <=>  L - R < 0  <=>  L - R <= -1.
% The program is solver-agnostic: swap `import pb` for `import cp`
% or `import sat` and it runs unchanged.
%
% With pb:  PICATPATH=<picat>/lib2 PBSOL=<solver> emu/picat strict.pi

import pb.

main =>
    A = new_array(3),
    A :: 0..1,
    A[1] #< A[2],
    A[1] + A[2] + A[3] #= 1,
    solve(A),
    printf("strict var: %w%n", [A[I] : I in 1..3]),
    B = new_array(4),
    B :: 0..1,
    B[1] + B[2] #< B[3] + B[4],
    B[1] + B[2] + B[3] + B[4] #= 3,
    solve(B),
    printf("strict sum: %w%n", [B[I] : I in 1..4]).
