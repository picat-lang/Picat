% subset-sum: choose some of the numbers so that they sum to the
% target.  The program is solver-agnostic: swap `import pb` for
% `import cp` or `import sat` and it runs unchanged -- pb sends the
% linear form to an external pseudo-Boolean solver, cp and sat are
% built in.
%
% With pb:  PICATPATH=<picat>/lib2 PBSOL=<solver> emu/picat subset_sum.pi
% With cp:  emu/picat subset_sum.pi        (after the import swap)

import pb.

main =>
    Nums = [3, 34, 4, 12, 5, 2],
    V = new_array(6),
    V :: 0..1,
    3 * V[1] + 34 * V[2] + 4 * V[3] + 12 * V[4] + 5 * V[5] + 2 * V[6] #= 9,
    solve(V),
    printf("picked %w%n", [Nums[I] : I in 1..6, V[I] = 1]).
