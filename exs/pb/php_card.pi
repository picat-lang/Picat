% php_card: the pigeon-hole principle in the CARDINALITY form: N
% holes, N+1 pigeons, one 0/1 var per pigeon-hole pair x[p][h].
% Every pigeon sits in some hole (>= 1 per pigeon row), no hole
% holds two pigeons (<= 1 per hole column).  UNSAT for every N.
% The linear form IS the UNSAT proof: sum the pigeon rows (>= N+1),
% sum the hole columns (<= N), add: 0 >= 1.  The DIRECT clausal
% translation has no counting structure, so its UNSAT proof needs
% exponential resolution and every CDCL solver inherits that bound
% (Haken 1985).  Caveat: the built-in sat and cp paths do NOT use
% the direct encoding -- their lowering of the cardinality
% constraints carries the counting in auxiliary structure (or in
% propagation), so they answer in ms too (php N=30: ~50 ms under
% both).  The exponential separation shows against the DIRECT
% clausal encoding, as in php_bench.pi (kissat: 1.8 s at N=10,
% >300 s at N=12) and in the pb_advantage measurements.
% Sized by the command line:
%   picat php_card.pi <holes>        (pigeons = holes + 1)
% The same program body runs unchanged under import pb, import cp
% and import sat; only the import line decides the solver.  pb sends
% the cardinality form to an external pseudo-Boolean solver (env
% PBSOL); cp and sat are built in.  No timing here -- the sweep
% script test/pb_families_bench.sh measures all three solvers.
%
% With pb:  PBSOL=<solver> PICATPATH=<picat>/lib2 emu/picat php_card.pi 8
% With cp:  emu/picat php_card.pi 8            (after the import swap)

import pb, os.

main([HolesS]) =>
    N = HolesS.to_int,
    P = N + 1,
    X = new_array(P * N),
    X :: 0..1,
    foreach (Pn in 1..P)
        sum([X[(Pn - 1) * N + H] : H in 1..N]) #>= 1
    end,
    foreach (H in 1..N)
        sum([X[(Pn - 1) * N + H] : Pn in 1..P]) #<= 1
    end,
    bp.c_wall_ms(T0),
    ( solve(X) ->
        bp.c_wall_ms(T1),
        printf("SAT: a placement exists (%d pigeons, %d holes, %d ms)%n", P, N, T1 - T0)
    ;
        bp.c_wall_ms(T1),
        printf("UNSAT: %d pigeons cannot fit into %d holes (%d ms)%n", P, N, T1 - T0)
    ).
