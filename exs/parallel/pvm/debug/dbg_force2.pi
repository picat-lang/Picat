% Forced-delegation experiment 2 (worker-wins shape).
%
% queens n=5, all 10 solutions:
%   1 {1,3,5,2,4}   6 {3,5,2,4,1}
%   2 {1,4,2,5,3}   7 {4,1,3,5,2}
%   3 {2,4,1,3,5}   8 {4,2,5,3,1}
%   4 {2,5,3,1,4}   9 {5,2,4,1,3}
%   5 {3,1,4,2,5}  10 {5,3,1,4,2}
%
% Poisons (deterministic, posted before solve, each prunes NO
% singleton domain, so every killed solution dies in SEARCH):
%   Q[2] #!= 4           -> Q2 domain {1,2,3,5}: fail-first picks Q2
%   3*Q[1] + Q[5] #!= 14 -> kills exactly #5,#7  (the Q2=1 solutions)
%   2*Q[1] + Q[4] #!= 11 -> kills exactly #8,#9  (the Q2=2 solutions)
% Survivors: {1,3,5,2,4},{5,3,1,4,2} (Q2=3) and
%            {2,5,3,1,4},{3,5,2,4,1} (Q2=5) -- all in the WORKER-only
% values {3,5}.
%
% Expected forced run (mode 1, C=1): root walks Q2=1 (search fail),
% force-take at the Q2=2 re-entry, root walks Q2=2 (search fail),
% root parks, worker chain takes Q2 in {3,5} and the worker -- not the
% root -- reports the first survivor {1,3,5,2,4}.
%
% Usage: picat dbg_force2.pi NT
% Run with PVM_FORCE_AR=<ar of the Q2 value-disjunction frame> and
% PVM_DBG=1: the CP frame that SKIP-STATes at creation and
% SKIP-SEENs on the value re-fires, just after the model descent.
import cp.

main => run(4).
main(Args) => run(to_int(Args[1])).

run(0) =>
    model(5, Q),
    writeln(Q).
run(NT) =>
    NT > 0,
    bp.pvm_fork(NT, 1, 1),
    ( model(5, Q),
      bp.pvm_report(Q)
    ;
      true ),
    bp.pvm_collect(R),
    writeln(R),
    ( R = 1,
      bp.pvm_solution(Qs),
      writeln(Qs)
    ;
      true ).

model(N, Q) =>
    Q = new_array(N),
    Q :: 1..N,
    foreach (I in 1..N, J in I+1..N)
        Q[I] #!= Q[J],
        abs(Q[I]-Q[J]) #!= J-I
    end,
    poisons(Q),
    solve([ff], Q).

poisons(Q) =>
    Q[2] #!= 4,
    3 * Q[1] + Q[5] #!= 14,
    2 * Q[1] + Q[4] #!= 11.
