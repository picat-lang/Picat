% Forced-delegation UNSAT shape: plain 3-queens is UNSAT; every value of
% the first-decided variable fails in search, so a forced delegation at
% that frame must exhaust the whole delegated region and yield a sound
% R=0 (not a crash, not a false R=1).
import cp.

main => run(4).
main(Args) => run(to_int(Args[1])).

run(0) =>
    model(3, Q),
    writeln(Q).
run(NT) =>
    NT > 0,
    bp.pvm_fork(NT, 1, 1),
    ( model(3, Q),
      bp.pvm_report(Q)
    ;
      true ),
    bp.pvm_collect(R),
    writeln(R),
    ( R = 1,
      bp.pvm_solution(Qs),
      writeln(Qs)
    ;
      true ).

model(N, Q) =>
    Q = new_array(N),
    Q :: 1..N,
    foreach (I in 1..N, J in I+1..N)
        Q[I] #!= Q[J],
        abs(Q[I]-Q[J]) #!= J-I
    end,
    solve([ff], Q).
