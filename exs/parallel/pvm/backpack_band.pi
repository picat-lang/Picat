% backpack_band: mode-4 variant -- the bound-lift loop whose round is
% PARTITIONED OVER THE OBJECTIVE VALUE RANGE in one mode-2 session
% (the in-engine form of "several increased bounds in parallel, one
% of them the current one"): with current bound B and upper end U,
% the round partitions the values B+1..U into NT static chunks
% (pvm_chunk); each worker owns a band [B+Lo, B+Hi], either finds a
% model inside its band (reports its band origin and the value) or
% proves its band empty (reports its band origin and 0). The root
% lifts B to the max reported value and tightens U to the lowest
% empty band that sits above the new B. A round in which every band
% reports empty proves B optimal (liveness veto as always: trusted
% only when every worker reported; the collect refuses a dead one).
 %
 % Live bound (pvm_fork_lb): a band is worthless the moment another
 % band finds a model at or above its top, so a worker band whose top
 % falls at or below the max value found in the round stops at its
 % next choice point, claiming the empty report for its band (which
 % the lift and the tightened-U readout provably ignore). On the
 % knapsack family the saving is at or below measurement noise --
 % the hard work is the final all-empty proving round (no model to
 % find) and the bands above the lift -- but the round no longer pays
 % for doomed bands when the timing allows.
 %
 % Tree-partition proving round (opt-in, PVM_TREE=1): when the
 % round's value range W is too thin for more than W value bands
 % (W <= NT), the round can partition the LABELING TREE instead: the
 % 2^m slices "X[1..m] = pattern" (m = ceil(log2 NT)) tile the
 % assignment space, each worker proves its chunk of patterns
 % model-free over the whole [B+1..U] range, and an all-empty round
 % proves B optimal as before. A tree round cannot tighten U (the
 % slices are not value intervals) -- irrelevant at that thinness,
 % and a lift simply tightens B for the next round. Measured 1.0x-
 % 5.4x SLOWER than the value-band round on this family whenever it
 % fires, so it is behind the flag: the band round already runs W
 % parallel workers, and a P=v band proof (P the most constrained
 % variable) is cheaper than a whole-window slice proof.
%
% Compare with backpack_pvm.pi: the same B&B loop, but each
% iteration there is one mode-1 session racing a single bound B+1
% over the 0/1 labeling tree -- the expensive final proving
% iteration (infeasible instance, no model to find) runs path-
% skewed and barely parallelizes. Here the final proving round is
% NT parallel per-value-band infeasibility proofs instead, so the
% proving work is spread over the workers by VALUE.
%
% NT = 1 degenerates to backpack_pvm's loop shape (one band = the
% whole interval; a round = one value-jump lift), which isolates
% the banding itself.
%
% Run modes:
%   N=20 picat exs/parallel/pvm/backpack_band.pi       NT=0: built-in
%                                               $max reference (serial;
%                                               the sat module's builtin
%                                               optimizer, binary-search
%                                               strategy by default)
%   N=20 NT=4 picat exs/parallel/pvm/backpack_band.pi  banded, 4 workers
%   N=20 NT=1 ...                                    single-band control
%
% N defaults to 20, NT to 0.
import sat.

main =>
    n_from_env(N),
    nt_from_env(NT),
    run(N, NT).

main(Args) =>
    ( Args = [A1],
      N = to_int(A1), nt_from_env(NT)
    ; Args = [A1, A2],
      N = to_int(A1), NT = to_int(A2)
    ),
    run(N, NT).

run(N, 0) =>
    bp.c_wall_ms(T0),
    bp_model0(N, X, Wd, Vd, P),
    solve([$max(P)], [X, Wd, Vd, P]),
    check_final(N, X, Wd, P, P),
    bp.c_wall_ms(T1),
    writef("backpack_band: N=%d serial $max: P=%d, items=%s, %d ms%n",
           N, P, to_string(to_list(X)), T1 - T0),
    halt.

run(N, NT) =>
    NT > 0,
    bp.c_wall_ms(T0),
    banded(N, NT, 0, 5 * N, 0, T0),
    halt.

% one round: partition the values B+1..U (W of them, numbered 1..W)
% into NT static chunks; each worker solves its band and reports
% each report is the ground list [Lo, V]: Lo = the chunk's lower end (1..W), V =
% the value of a model found in the band, or 0 if the band is
% proven empty.
banded(N, NT, B, U, Iter, T0) =>
    W = U - B,
    ( W <= 0 ->
        final(N, NT, B, Iter, T0)
    ;
      W <= NT,
      % the value range is too thin for more than W value bands (and
      % W of them at best).  With PVM_TREE=1 the round partitions the
      % LABELING TREE instead: 2^m prefix-pattern slices of the
      % search, each worker proving its slice model-free over the
      % whole range.  Off by default: measured on this family (5
      % reps, 2026-08-27) the slice round is 1.0x-5.4x SLOWER than
      % the value-band round whenever it fires -- the band round
      % already runs W parallel workers, and a P=v band proof is
      % cheaper than a whole-window slice proof (P is the most
      % constrained variable, so value is the right partition).
      tree_on(T),
      T > 0,
      tree_round(N, NT, B, U, Iter, T0)
    ;
      nchunks(NT, W, Nch),
      % live-bound round: a worker band whose top falls at or below
      % the max value another band finds stops at its next choice
      % point (it claims the empty report; the lift ignores bands at
      % or below the new bound), so a lifting round pays only for the
      % bands still above the lift.
      bp.pvm_fork_lb(NT, 2, W, B),
      bp.pvm_worker_id(I),
      ( I > 0,
        bp.pvm_chunk(Lo, Hi),
        ( Lo > Hi ->
            bp.pvm_report([Lo, 0])
        ;
          ( bp_band(N, B + Lo, B + Hi, X, Wd, Vd, P)
          -> bp.pvm_report([Lo, P])
          ; bp.pvm_report([Lo, 0])
          )
        )
      ;
        bp.pvm_collect(Rep),
        Nrep = length(Rep),
        Nrep == Nch,
        step(N, NT, B, U, Iter, T0, Rep)
      )
    ).

% the mode-2 chunking is by size, not by worker count: the engine
% cuts the W values into chunks of ceil(W/NT) and forks one static
% worker per chunk, so the worker count is ceil(W/ceil(W/NT))
% (e.g. NT=8, W=12 -> 6 workers), measured in /tmp/m2count.pi.
nchunks(NT, W, Nch) =>
    C = (W + NT - 1) // NT,
    Nch = (W + C - 1) // C.

% root side of a round: B' = max reported value; an empty band
% whose origin B+Lo lies above B' proves [B+Lo, ...] model-free,
% tightening U to B+Lo-1. No report above B: every band of
% [B+1..U] is proven empty, B is optimal.
step(N, NT, B, U, Iter, T0, Rep) =>
    Vs = [ V : [_, V] in Rep ],
    Vmax = max(Vs),
    ( Vmax > B ->
        tighten(U, B, Vmax, Rep, U1),
        writef("  round %d: B %d -> %d, U %d -> %d%n", Iter + 1, B, Vmax, U, U1),
        banded(N, NT, Vmax, U1, Iter + 1, T0)
    ;
      writef("  round %d: all bands empty, B=%d optimal%n", Iter + 1, B),
      final(N, NT, B, Iter + 1, T0)
    ).

% min over the empty bands whose origin sits above the new bound.
tighten(U0, B, Vmax, Rep, U1) =>
    Cuts = [ B + Lo - 1 : [Lo, 0] in Rep, B + Lo > Vmax ],
    ( Cuts == [] -> U1 = U0 ; U1 = min(Cuts) ).

% tree-partition round: A = 2^m slices, slice Pat (0..A-1) =
% "X[1..m] equals the m-bit pattern Pat"; the slices tile the whole
% assignment space, so an all-empty round proves [B+1..U] model-free
% exactly as an all-empty band round (and the liveness veto covers
% the verdict as always). Each worker owns a chunk of CONSECUTIVE
% patterns and proves them one by one, reporting the max value found
% (or 0). Plain pvm_fork, no live bound: a value found in one
% pattern invalidates no other pattern (slices are not value-ordered).
tree_round(N, NT, B, U, Iter, T0) =>
    m_of(NT, M, A),
    nchunks(NT, A, Nch),
    bp.pvm_fork(NT, 2, A),
    bp.pvm_worker_id(I),
    ( I > 0,
      bp.pvm_chunk(Lo, Hi),
      tree_slices(N, B, U, M, Lo, Hi, Vres),
      bp.pvm_report([Lo, Vres])
    ;
      bp.pvm_collect(Rep),
      Nrep = length(Rep),
      Nrep == Nch,
      tree_step(N, NT, B, U, Iter, T0, Rep)
    ).

% the smallest m with 2^m >= NT, with A = 2^m (NT <= 16 here, so
% m <= 4 and the prefix X[1..m] always exists).  Iterative doubling
% (the parser of this build rejects a variable operand of **), and an
% if-then-else body (this build never tries a same-head clause whose
% guard follows a failed guard of the preceding same-head clause).
m_of(NT, M, A) => m_of(NT, 0, 1, M, A).
m_of(NT, MC, A, M, A2) =>
  ( A >= NT -> M = MC, A2 = A
  ; A < NT, m_of(NT, MC + 1, 2 * A, M, A2)
  ).

% prove every pattern in [PatLo, PatHi] model-free in [B+1..U];
% Vres = max value found over the worker's patterns, or 0.  The max
% is kept in a LOCAL accumulator (new binding, :=): a plain
% Vres = max(Vres, P) would try 0 = P on the first model found and
% fail the worker's guard sequence (root-arm fallthrough, bad flag),
% and a := on an argument variable rebinds it only in this clause's
% environment -- the caller would keep the old value.
tree_slices(N, B, U, M, PatLo, PatHi, Vres) =>
    V = 0,
    foreach (Pat in (PatLo - 1) .. (PatHi - 1))
        ( bp_tree(N, B, U, M, Pat, X, Wd, Vd, P)
        -> V := max(V, P)
        ; true
        )
    end,
    Vres = V.

% the backpack encoding, the whole proving range instead of one
% value band, plus the m-bit prefix of X[1..m] fixed to Pat.
bp_tree(N, B, U, M, Pat, X, Wd, Vd, P) =>
    X = new_array(N),
    X :: 0..1,
    foreach (I in 1..M)
        BitI = bit_of(I, Pat),
        X[I] #= BitI
    end,
    Wd = new_array(N),
    Vd = new_array(N),
    foreach (I in 1..N)
        Wd[I] #= ((I-1) mod 5 + 1) * X[I],
        Vd[I] #= ((2*I) mod 5 + 1) * X[I]
    end,
    sum(Wd) #<= N,
    P #= sum(Vd),
    P #>= B + 1,
    P #=< U,
    solve([ff], [X, Wd, Vd, P]).

% the I-th bit (1-based) of Pat: bit 1 = least significant; halve
% towards the bit instead of dividing by 2^(I-1).
bit_of(1, Pat) = Pat mod 2.
bit_of(I, Pat) = R => bit_of(I - 1, Pat // 2) = R.

% root side: a tree round either lifts B (U kept: the slices carry
% no tightening information) or proves B optimal.
tree_step(N, NT, B, U, Iter, T0, Rep) =>
    Vs = [ V : [_, V] in Rep ],
    Vmax = max(Vs),
    ( Vmax > B ->
        writef("  round %d (tree): B %d -> %d%n", Iter + 1, B, Vmax),
        banded(N, NT, Vmax, U, Iter + 1, T0)
    ;
      writef("  round %d (tree): all slices empty, B=%d optimal%n", Iter + 1, B),
      final(N, NT, B, Iter + 1, T0)
    ).

% the band instance: the backpack encoding plus Lo <= P <= Hi.
bp_band(N, Lo, Hi, X, Wd, Vd, P) =>
    X = new_array(N),
    X :: 0..1,
    Wd = new_array(N),
    Vd = new_array(N),
    foreach (I in 1..N)
        Wd[I] #= ((I-1) mod 5 + 1) * X[I],
        Vd[I] #= ((2*I) mod 5 + 1) * X[I]
    end,
    sum(Wd) #<= N,
    P #= sum(Vd),
    P #>= Lo,
    P #=< Hi,
    solve([ff], [X, Wd, Vd, P]).

% the model at the proven bound (no lower bound of its own): used
% for the serial $max reference.
bp_model0(N, X, Wd, Vd, P) =>
    X = new_array(N),
    X :: 0..1,
    Wd = new_array(N),
    Vd = new_array(N),
    foreach (I in 1..N)
        Wd[I] #= ((I-1) mod 5 + 1) * X[I],
        Vd[I] #= ((2*I) mod 5 + 1) * X[I]
    end,
    sum(Wd) #<= N,
    P #= sum(Vd),
    P #>= 0.

  % the loop's leaf: B is proven optimal. One plain serial solve at
  % the proven bound re-derives an optimal model (B is feasible by
  % construction); the verify step recomputes weight and value from X
  % alone and asserts P == B. Runs OUTSIDE any session.
  final(N, NT, B, Iter, T0) =>
      bp_vars(N, B, X, Wd, Vd, P),
      solve([ff], [X, Wd, Vd, P]),
      P == B,
      check_final(N, X, Wd, P, B),
      report_final(N, NT, B, Iter, T0, X).

  report_final(N, NT, B, Iter, T0, X) =>
      bp.c_wall_ms(T1),
      writef("backpack_band: N=%d banded NT=%d: P=%d, rounds=%d, items=%s, %d ms%n",
             N, NT, B, Iter, to_string(to_list(X)), T1 - T0).

bp_vars(N, Lo, X, Wd, Vd, P) =>
    X = new_array(N),
    X :: 0..1,
    Wd = new_array(N),
    Vd = new_array(N),
    foreach (I in 1..N)
        Wd[I] #= ((I-1) mod 5 + 1) * X[I],
        Vd[I] #= ((2*I) mod 5 + 1) * X[I]
    end,
    sum(Wd) #<= N,
    P #= sum(Vd),
    P #>= Lo.

check_final(N, X, Wd, P, B) =>
    Wused = sum(Wd),
    (Wused <= N) -> true ; handle_exception($weight_over(Wused), check_final),
    Vsum = value_of(N, X),
    (Vsum == P) -> true ; handle_exception($value_mismatch(P, Vsum), check_final),
    (P == B) -> true ; handle_exception($not_optimal(P, B), check_final).

% independent recomputation from X alone (the pattern, not the
% model's arrays): the final model is verified against it.
value_of(N, X, V) =>
    L = [((2*I) mod 5 + 1) : I in 1..N, X[I] == 1],
    V = sum(L).

n_from_env(N) =>
    ((bp.picat_getenv("N", S)) -> N = to_int(S) ; N = 20),
    (N >= 3),
    (N <= 100).

nt_from_env(NT) =>
    ((bp.picat_getenv("NT", S)) -> NT = to_int(S) ; NT = 0),
    (NT >= 0),
    (NT <= 4096).

% opt-in tree-partition proving rounds (see the W <= NT branch of
% banded/6 for the measurement notes): on when PVM_TREE is set.
tree_on(T) => ((bp.picat_getenv("PVM_TREE", S)) -> T = 1 ; T = 0).
