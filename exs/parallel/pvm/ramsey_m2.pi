% ramsey_m2: (K,K)-Ramsey search, mode-2 JOINT partition over the first
% M edge variables.
%
% Partition: the first M edges as a bit pattern,
%     val = 1 + E[1] + 2*E[2] + 4*E[3] + ... + 2^(M-1)*E[M],  in 1..2^M
% (E[1] least significant = the fastest decision frame, the same order
% the engine's chunk walk counts, cf. queens_count2's
% Q[1] + N*(Q[2]-1) joint value).
% T must equal 2^M (or 0): with T = 2^M each static chunk is a SINGLE
% bit-pattern value V (as in queens_count2's 17 x 17 = 289 single pairs),
% and the worker restricts its slice by unit constraints
%     E[j] #= the j-th bit of V   (j = 1..M, E[1] the low bit)
% -- the same driver-side chunk restriction queens_count2 posts on its
% joint value. The 2^M prefix regions tile the search space exactly:
% every full assignment matches exactly one region, so the UNSAT verdict
% (all regions proven empty, liveness-vetoed) is sound.
%
% Env: K, N (N must be set explicitly for K != 3), T (workers;
% 0 = plain serial oracle; for T > 0, M must satisfy 2^M = T),
% M (bitpack width).
%
%   K=3 N=5 T=4 M=2 picat ramsey_m2.pi     % sum of 4 chunk counts = serial count
%   K=3 N=6 T=8 M=3 picat ramsey_m2.pi     % UNSAT: all chunks 0
%   K=4 N=18 T=256 M=8 picat ramsey_m2.pi  % the R(4,4) cell
%
% The R(4,4) cell (measured on this machine, one batch): the built-in
% serial run makes no progress (no verdict in a 2 h budget; the mode-3
% driver records no progress in 25 s single-core), but the whole-tree
% UNSAT proof completes via the joint partition:
%   T=16  M=4:  UNSAT in 1844.5 s (all 16 chunks empty)
%   T=128 M=7:  UNSAT in 176.9  s (all 128 chunks empty)
%   T=256 M=8:  UNSAT in 118.3  s (all 256 chunks empty)
% 16x workers -> 15.6x wall reduction: the wall is the single hardest
% chunk, which shrinks by 2^m per added partition bit. Tiling soundness
% (exact chunk-count sums) verified on K=3: N=4: 8 = 3+5 = 1+3+2+2 =
% 0+1+1+1+2+1+2+0; N=5: 12 = 2+2+4+4; N=6: UNSAT at T=8 all-zero.

import sat.

main =>
    k_from_env(K),
    n_from_env(K, N),
    t_from_env(T),
    m_from_env(M),
    C2 = pow2(M),
    ( T > 0 ->
        ( T = C2 -> true
        ; handle_exception($t_must_equal_2_to_m(T, C2), main) )
    ; true ),
    ( T > 0 -> Tag = " (mode 2)" ; Tag = " (serial oracle)" ),
    bp.c_wall_ms(T0),
    writef("=== ramsey_m2: K=%d N=%d T=%d M=%d (chunks of 1..%d), %d edge vars%s%n",
        K, N, T, M, C2, N * (N - 1) // 2, Tag),
    ( T > 0,
        bp.pvm_fork(T, 2, C2),
        bp.pvm_worker_id(I),
        ( I > 0,
            bp.pvm_chunk(Lo, Hi),
            ( Hi = Lo -> true
            ; handle_exception($chunk_not_single(Lo, Hi), main) ),
            slice_count(K, N, M, Lo, C),
            writef("worker %d: chunk [%d..%d] count=%d%n", I, Lo, Hi, C),
            bp.pvm_report(C)
        ;
            bp.pvm_collect(Counts),
            Csum = sum(Counts),
            bp.c_wall_ms(T1),
            root_verdict(K, N, T0, T1, T, Csum, Counts)
        )
    ;
        slice_count(K, N, M, 1, Csum),
        bp.c_wall_ms(T1),
        serial_verdict(K, N, T0, T1, Csum)
    ),
    halt.

% the instance, plus (for M > 0) the unit prefix E[j] #= bit_j(Lo);
% C = #models of the slice
slice_count(K, N, M, Lo, C) =>
    MM = K * (K - 1) // 2,
    NPairs = N * (N - 1) // 2,
    subsets(K, N, AllSets),
    E = new_array(NPairs),
    E :: 0..1,
    no_k_sets(N, K, MM, AllSets, E),
    degree_order(N, E, D),
    ( M > 0, prefix(M, E, Lo) ; true ),
    (C = count_all(solve([], [E, D])) -> true
    ; C = 0).

% unit constraints E[J] #= bit_J(Lo), J = M..1 (Lo = 1 + bit pattern)
prefix(0, _E, _V) => true.
prefix(J, E, V) =>
    WJ = pow2(J - 1),
    Q = (V - 1) div WJ,
    Bv = Q - 2 * (Q div 2),
    E[J] #= Bv,
    prefix(J - 1, E, V).

pow2(0) = 1.
pow2(I) = 2 * pow2(I - 1).

root_verdict(K, N, T0, T1, T, Csum, Counts) =>
    ( Csum > 0 ->
        writef("SAT (mode 2): %d workers, %d models in total in %d ms -- a (K,K)-Ramsey graph on %d vertices exists, R(%d,%d) >= %d (witness: rerun ramsey_pvm)%n",
            T, Csum, T1 - T0, N, K, K, N + 1)
    ;
        writef("UNSAT (mode 2): %d workers, all %d chunks proven empty in %d ms -- every graph on %d vertices has a %d-clique or an independent %d-set, i.e. R(%d,%d) <= %d%n",
            T, T, T1 - T0, N, K, K, K, K, N)
    ),
    writeln(Counts).

serial_verdict(K, N, T0, T1, Csum) =>
    ( Csum > 0 ->
        writef("SAT (serial): %d models in %d ms -- R(%d,%d) >= %d%n",
            Csum, T1 - T0, K, K, N + 1)
    ;
        writef("UNSAT (serial): %d ms -- R(%d,%d) <= %d%n",
            T1 - T0, K, K, N)
    ).

k_from_env(K) =>
    ((bp.picat_getenv("K", S)) -> K = to_int(S) ; K = 3),
    (K >= 2 -> true ; handle_exception($k_expected_at_least_2(K), main)).

n_from_env(K, N) =>
    ((bp.picat_getenv("N", S)) -> N = to_int(S)
    ;
    (K == 3 -> N = 6 ; handle_exception($n_env_var_expected(K), main))
    ),
    (N >= K -> true ; handle_exception($n_expected_at_least_k(K, N), main)).

t_from_env(T) =>
    ((bp.picat_getenv("T", S)) -> T = to_int(S) ; T = 0),
    (T >= 0 -> true ; handle_exception($t_expected_at_least_0(T), main)).

m_from_env(M) =>
    ((bp.picat_getenv("M", S)) -> M = to_int(S) ; M = 0),
    (M >= 0 -> true ; handle_exception($m_expected_at_least_0(M), main)).

% 1-based array index of the edge (I,J), 0 <= I < J < N
pair_idx(I, J, N) =
    I * (N - 1) - I * (I - 1) // 2 + (J - I).

% all strictly increasing K-element subsets of {0..N-1}
subsets(K, N, All) =>
    Dom = [I : I in 0..(N - 1)],
    All = findall(S, comb(K, Dom, S)).

comb(0, _Dom, S) => S = [].
comb(K, [H|T], S) =>
    K > 0,
    (take_c(K, H, T, S) ; drop_c(K, T, S)).

take_c(K, H, T, S) =>
    Len = length(T),
    Len >= K - 1,
    S = [H|R],
    comb(K - 1, T, R).

drop_c(K, T, S) =>
    Len = length(T),
    Len >= K,
    comb(K, T, S).

no_k_sets(N, K, M, Sets, E) =>
    foreach (S in Sets)
        Ev = [E[pair_idx(S[P], S[Q], N)] : P in 1..K, Q in P + 1..K],
        sum(Ev) #=< M - 1,
        sum(Ev) #>= 1
    end.

% D[I] = degree of vertex I; vertices assumed sorted by degree
% (non-increasing): a valid symmetry breaking.
degree_order(N, E, D) =>
    D = new_array(N),
    D :: 0..(N - 1),
    foreach (I in 0..(N - 1))
        Di = [E[pair_idx(J, I, N)] : J in 0..(I - 1)]
           ++ [E[pair_idx(I, J, N)] : J in (I + 1)..(N - 1)],
        D[I + 1] #= sum(Di)
    end,
    foreach (I in 0..(N - 2))
        D[I + 1] #>= D[I + 2]
    end.
