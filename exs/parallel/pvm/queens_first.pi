% First n-Queens solution with OR-parallel value delegation; also the
% N=479 distinct-differences benchmark (same constraints, larger N).
%
% Usage:  picat queens_first.pi [N] [NT] [MODE] [C] [PIN]
%   N    board size (default 10)
%   NT   worker budget, 0 = serial (default)
%   MODE 1 = the C=1 OR split, 3 = value chunks of size C (default 3)
%   C    mode-3 chunk size (default 1)
%   PIN  fix Q[1]=PIN for the deep-search shape (default 0 = free)
%
% Example invocations from the engineering report:
%   queens_first.pi 10 4 3 2 4     % the worked example (was m3r2)
%   queens_first.pi 10 4 1 1 0     % mode-1 family (was t_pvma10)
%   queens_first.pi 479            % the N=479 serial baseline
%   queens_first.pi 479 16 3 64 0  % the mode-3 NT x C grid cells
import cp.

main => run(10, 0, 3, 1, 0).
main(Args) =>
    ( Args = [],
      run(10, 0, 3, 1, 0)
    ; Args = [A1],
      run(to_int(A1), 0, 3, 1, 0)
    ; Args = [A1, A2],
      run(to_int(A1), to_int(A2), 3, 1, 0)
    ; Args = [A1, A2, A3],
      run(to_int(A1), to_int(A2), to_int(A3), 1, 0)
    ; Args = [A1, A2, A3, A4],
      run(to_int(A1), to_int(A2), to_int(A3), to_int(A4), 0)
    ; Args = [A1, A2, A3, A4, A5],
      run(to_int(A1), to_int(A2), to_int(A3), to_int(A4), to_int(A5))
    ).

run(N, 0, _, _, P) =>
    model_q(N, P, Q),
    writeln(Q).
run(N, NT, M, C, P) =>
    NT > 0,
    bp.pvm_fork(NT, M, C),
    % one body for every process: a mode 1/3 worker resumes inside
    % its delegated value (never through a worker_id branch), so the
    % report must sit where the search itself succeeds. The solution
    % is reported BY VALUE (the integer array Q); a process whose
    % territory does not hold it fails the model and takes the true
    % branch. The root materializes the reported value after the
    % collect, so the solution is printed exactly once, there.
    ( model_q(N, P, Q),
      bp.pvm_report(Q)
    ; true ),
    bp.pvm_collect(R),
    writeln(R),
    ( R = 1,
      bp.pvm_solution(Qs),
      writeln(Qs)
    ; true ).

model_q(N, P, Q) =>
    Q = new_array(N),
    Q :: 1..N,
    ( P = 0, true ; Q[1] #= P ),
    foreach (I in 1..N-1, J in I+1..N)
        Q[I] #!= Q[J],
        abs(Q[I]-Q[J]) #!= J-I
    end,
    % the delegation window opens around the solve only: the CP
    % decision frames inside it are the delegable value disjunctions;
    % the loop frames above and the (model; true) wrapper below stay
    % serial (a worker's trivial success in a fallback clause is
    % indistinguishable from exhaustion in the done registry).
    bp.pvm_delegate(1),
    solve([ff], Q),
    bp.pvm_delegate(0).
