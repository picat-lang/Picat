% Parblock-flavoured N-Queens counting:  the same problem as
% exs/parallel/pvm/queens_count.pi,  but written against the phase-1b
% par_run API.  The contrast is the point:
%
%   queens_count.pi      bp.pvm_fork / pvm_worker_id / pvm_chunk /
%                        pvm_report / pvm_collect --- the whole mode-2
%                        session is spelled out by the user
%   this file            Tasks = [ {qcount, {N, C}} : C in 1..N ],
%                        Rs    = parblock_pvm.par_run(NT, Tasks),
%                        T     = sum(Rs)
%
% The task list IS the parallelism:  one task per possible first-queen
% column C (the classic mode-2 chunk is a task here),  and the session
% (fork, chunking, per-task dispatch, collect, order, rethrow) is
% entirely inside par_run.  NT = 0 runs the identical program
% serially (the library falls back to the phase-0 par_run),  so one
% source serves both backends.
%
% Usage:  from the repo root:
%   emu/picat -path lib2 exs/parallel/parblock/queens_count.pi [N] [NT]
%   N    default 10;   NT  default 4  (0 = serial)
%
% Known totals (OEIS A000170),  asserted below for 8/10/12/13:
%   8=92, 10=724, 12=14200, 13=73712, 14=365596
import cp.
import parblock_pvm.

main()         => run(10, 4).
main([NS])     => run(to_int(NS), 4).
main([NS, NTS]) =>
    run(to_int(NS), to_int(NTS)).

run(N, NT) =>
    Tasks = [ {qcount, {N, C}} : C in 1..N ],
    Rs = parblock_pvm.par_run(NT, Tasks),
    T = sum(Rs),
    expect_of(N, E),
    printf("N=%d NT=%d  per-column=%s  total=%d", N, NT, to_string(Rs), T),
    ( E > 0,
      T = E,
      printf("  == expected %d  ok\n", E)
    ;
      printf("\n") ).

% one task:  count all solutions with the first queen in column C1
qcount(Blk) = S =>
    Blk = {N, C1},
    once(count1(N, C1, S)).

count1(N, C1, S) =>
    Q = new_array(N),
    Q :: 1..N,
    Q[1] = C1,
    foreach (I in 1..N-1, J in I+1..N)
        Q[I] #!= Q[J],
        abs(Q[I] - Q[J]) #!= I - J
    end,
    S = count_all(solve([ff], Q)).

expect_of(8,  92).
expect_of(10, 724).
expect_of(12, 14200).
expect_of(13, 73712).
expect_of(_,  0).
