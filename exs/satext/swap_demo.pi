% swap_demo: the standard SAT flow with an exchangeable external solver.
%
% The program below never changes -- the solver is selected at the
% solve call through one of:
%   SATEXT_SOLVER=<solver>      environment variable
%   bp.c_satext_set_solver(S)   in the program (atom/string, or a list
%                               of strings forming the solver argv)
% With none of them set, the embedded solver is used.
%
% Run:  picat exs/satext/swap_demo.pi
%       SATEXT_SOLVER=kissat picat exs/satext/swap_demo.pi
%       SATEXT_SOLVER=cryptominisat picat exs/satext/swap_demo.pi
% (PICATPATH is not needed for this demo.)

import sat.

main =>
    % --- the user's program: constraints then solve ---
    A :: 0..5, B :: 0..3,
    A+B #= 3,
    solve([A,B]),
    writef("A+B=3        : %s%n", to_string(A) ++ "+" ++ to_string(B)
             ++ "=" ++ to_string(A+B)),

    % --- same flow, external solver chosen in-program ---
    bp.c_satext_set_solver(kissat),
    queens4(Q1),
    solve(Q1),
    check_queens(4, Q1),
    writef("4-queens ext : %s%n", to_string(to_list(Q1))),

    % --- all solutions, external solver ---
    queens4(Q2),
    Sols = findall([Q2[1], Q2[2], Q2[3], Q2[4]], solve_one(Q2)),
    writef("4-queens all : %s solutions%n", to_string(len(Sols))),
    ((len(Sols) == 2) -> true ; handle_exception($count(len(Sols)), main)),

    % --- a different solver that only reads a CNF file ---
    bp.c_satext_set_solver(["cryptominisat", "@file"]),
    C :: 0..1, D :: 0..1, E :: 0..1,
    C+D+E #= 2,
    solve([C,D,E]),
    writef("c+d+e=2 cmsat: %s%n", to_string(C) ++ to_string(D)
             ++ to_string(E)),
    halt.

solve_one(Qs) => solve(Qs).

queens4(Qs) =>
    Qs = new_array(4),
    Qs :: 1..4,
    foreach (I in 1..3, J in I+1..4)
        Qs[I] #!= Qs[J],
        Qs[I]-Qs[J] #!= J-I,
        Qs[J]-Qs[I] #!= J-I
    end.

check_queens(N, Qs) =>
    bad(N, Qs, Bad),
    (Bad == 0) -> true ; handle_exception($bad_queens(Bad), check_queens).

bad(N, Qs, Bad) =>
    B1 = [1 : I in 1..N-1, J in I+1..N, same_col(I, J, Qs)],
    B2 = [1 : I in 1..N-1, J in I+1..N, same_diag(I, J, Qs)],
    Bad = len(B1) + len(B2).

same_col(I, J, Qs) =>
    Qs[I] == Qs[J].

same_diag(I, J, Qs) =>
    abs(Qs[I]-Qs[J]) == J-I.
