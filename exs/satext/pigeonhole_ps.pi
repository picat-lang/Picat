% pigeonhole_ps: pigeonhole principle sized by an environment var, for
% testing the UNSAT path of the external solver(s) -- the companion
% to queens_ps (which tests the SAT path).
%
% N holes, N+1 pigeons: UNSAT for every N. Encoding: x[p,h] in {0,1}
% = "pigeon p sits in hole h"; each pigeon sits in at least one hole,
% each hole holds at most one pigeon (the classical encoding).
%
% Built-in solver:
%   N=8 picat exs/satext/pigeonhole_ps.pi
%
% One external solver:
%   N=9 SATEXT_SOLVER=kissat picat exs/satext/pigeonhole_ps.pi
%   N=9 SATEXT_SOLVER=/usr/bin/cryptominisat picat exs/satext/pigeonhole_ps.pi
%   N=9 SATEXT_SOLVER="kissat -q" picat exs/satext/pigeonhole_ps.pi
%       (SATEXT_SOLVER is whitespace-separated solver argv: first
%        token = executable, the rest = extra arguments)
%
% Several solvers at once -- first-wins portfolio: '|' separates
% several argv strings, e.g.
%   N=9 SATEXT_SOLVER="kissat|cryptominisat" picat pigeonhole_ps.pi
% The same solvers can be repeated with different CLI parameters:
%   N=9 SATEXT_SOLVER="kissat|kissat -q" picat exs/satext/pigeonhole_ps.pi
% (two kissat processes race, one quiet; the first decisive answer
% wins and the other process group is killed). In-program, the same
% selections are lists (of argv lists):
%   bp.c_satext_set_solver([["kissat"],["kissat","-q"],["cryptominisat"]])
% Controls: SATEXT_PRT_BUDGET_MS (wall budget per solve, 0 = none),
% SATEXT_PRT_MIN (race only above this CNF size), SATEXT_PRT_STATS
% (one stderr line per solve with each racer's time and the winner).
%
% Like queens_ps, the external solver(s) run as child processes you
% can watch in another terminal with
%   ps -ef | grep -E "kissat|cryptominisat"
% (with a portfolio, the solvers run CONCURRENTLY and all but the
 % winner are killed). Note: modern solvers with symmetry handling
 % (kissat, cryptominisat) settle these instances in milliseconds even
 % for large N, so the process may disappear between polls -- use
 % SATEXT_PRT_STATS=1 for a per-racer timing line, or raise N (e.g.
 % N=15) for a bigger instance; a portfolio runs N racers' worth of
 % CPU per solve.
%
% N defaults to 8 when the N env var is absent (N = number of holes,
% i.e. N+1 pigeons). UNSAT is the expected outcome; the program errors
% if a model is ever produced.

import sat.

main =>
    n_from_env(H),
    P = H + 1,
    bp.c_wall_ms(T0),
    writef("=== pigeonhole: %d pigeons into %d holes (UNSAT expected), starting at %d ms%n", P, H, T0),
    ph(P, H, X),
    ph_check(X, T0),
    halt.

ph_check(X, T0) =>
    try_solve(X, Solved),
    ((Solved == 1) -> sat_found() ; unsat_ok(T0)).

sat_found() =>
    writef("UNEXPECTED: SAT found%n"),
    handle_exception($unexpected_sat, main).

unsat_ok(T0) =>
    bp.c_wall_ms(T1),
    writef("UNSAT detected (%d ms), as expected%n", T1 - T0).

n_from_env(H) =>
    ((bp.picat_getenv("N", S)) -> H = to_int(S) ; H = 8).

ph(P, H, X) =>
    X = new_array(P * H),
    X :: 0..1,
    foreach (I in 1..P)
        Holes = [T : J in 1..H, T = X[(I-1) * H + J]],
        1 #<= sum(Holes),
    end,
    foreach (J in 1..H, I in 1..P-1, K in I+1..P)
        X[(I-1) * H + J] + X[(K-1) * H + J] #= 1
    end.

try_solve(X, Solved) =>
    ((solve([X])) -> Solved = 1 ; Solved = 0).
