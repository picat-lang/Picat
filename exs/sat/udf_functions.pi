/*
 *  User-defined functions in constraints with the  sat  solver.
 *  Uses  lib/udf.pi  and the  sat  operator shims in  udf_ops_sat.pi.
 *
 *  RUN (the  udf  module lives in the repo's  lib  directory):
 *    cd ~/snapshotable/picatconstrfunc/exs/sat
 *    PICATPATH=~/snapshotable/picatconstrfunc/lib  ../../emu/picat  udf_functions.pi
 *    # or  ../../emu/picat -path ~/snapshotable/picatconstrfunc/lib  udf_functions.pi
 */
 import sat.
 import udf.
 include "udf_ops_sat.pi".

 main =>
     % register user functions usable in constraints
     udf.define($sum_prod(K, X), $(X + 3*K)),     % compound:  X + 3*K
     udf.define($total([]), 0),                      % structural recursion
     udf.define($total([H|T]), $(H + total(T))),

     % ---- normal source style, thanks to udf_ops_sat.pi ----
     X :: 1..20,
     Y :: 1..20,
     X #= $sum_prod(2, 1),          % X = 1 + 3*2 = 7
     Y #= $total([1,2,3]),          % Y = 1+2+3   = 6

     solve([], [X, Y]),
     printf("X=%w  Y=%w  total([1,2,3])=%w%n", X, Y, udf.flatten($total([1,2,3]))).
