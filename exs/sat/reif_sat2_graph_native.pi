% Reified ("_reif") and test ("_test") variants of the graph global
% constraints (lib/global_reif_graph.pi, included by module cp2):
%
%   circuit  subcircuit  acyclic  acyclic_d  hcp  scc  tree
%
% For every predicate  g_reif(Args, B) /  g_test(Args, B),  B  is a
% boolean dvar with  B = 1  iff  g(Args)  holds.
%
%  t01..t03  count  B = 1  on small instances  (hand-computed).
%  t04..t05  verify each reif against the un-reified original as an
%  oracle on the 3-vertex triangle:  the set of  (V, E)  tuples for
%  which the reif can force  B = 1  must equal the set of tuples
%  satisfying the original  (hand-computed:  17, 18).
%
%  The  hcp / scc / tree  oracle comparisons (t06..t08 in
%  exs/cp/reif_cp2_graph_native.pi) are not run under sat2:  this
%  3.9#12 emu build's sat2 labeling search does not terminate on
%  those reif stores ( > 29 min  for a single test,  vs  ~4s  under
%  cp2).  The reif code is shared (lib/global_reif_graph.pi);  the
%  hcp/scc/tree equivalences are verified by the cp2 battery.
%
%   PICATPATH=lib timeout 600 emu/picat exs/sat/reif_sat2_graph_native.pi   (from the repo root)

import sat2.

% -- local counting helper -------------------------------------------
n1(P) = C => n1(P, C, 0).
n1([], C, C0) => C = C0.
n1([1 | T], C, C0) => n1(T, C, C0+1).
n1([_ | T], C, C0) => n1(T, C, C0).

% -- set helpers ------------------------------------------------------
sort_list(L) = R => sort(L) = R.
sort_uniq(L) = R =>
    sort(L) = S,
    suq(S) = R.
suq([]) = [].
suq([X]) = [X].
suq([X, X | T]) = R => suq([X] ++ T) = R.
suq([X | T]) = R =>
    suq(T) = T2,
    R = [X | T2].

% project the  B  slot off  7-/8-tuples
p6_7t([]) = [].
p6_7t([{A, B, C, D, E, F, _Bv} | T]) = R =>
    p6_7t(T) = T2,
    R = [{A, B, C, D, E, F} | T2].
b1_7t([]) = [].
b1_7t([{A, B, C, D, E, F, 1} | T]) = R =>
    b1_7t(T) = T2,
    R = [{A, B, C, D, E, F} | T2].
b1_7t([{_, _, _, _, _, _, 0} | T]) = R =>
    b1_7t(T) = R.
p7_8t([]) = [].
p7_8t([{A, B, C, D, E, F, K, _Bv} | T]) = R =>
    p7_8t(T) = T2,
    R = [{A, B, C, D, E, F, K} | T2].
b1_8t([]) = [].
b1_8t([{A, B, C, D, E, F, K, 1} | T]) = R =>
    b1_8t(T) = T2,
    R = [{A, B, C, D, E, F, K} | T2].
b1_8t([{_, _, _, _, _, _, _, 0} | T]) = R =>
    b1_8t(T) = R.

% -- t01..t03:  counting instances ------------------------------------
t01() =>
    X :: 1..3, Y :: 1..3, Z :: 1..3,
    circuit_reif([X, Y, Z], By),
    P = findall(By, solve([X, Y, Z, By])),
    printf("01 circuit 3v1..3       : total=%d B1=%d (expect 27/2)%n",
        length(P), n1(P)).
t02() =>
    X :: 1..4, Y :: 1..4, Z :: 1..4, W :: 1..4,
    all_different([X, Y, Z, W]),
    circuit_test([X, Y, Z, W], By),
    P = findall(By, solve([X, Y, Z, W, By])),
    printf("02 circuit 4v1..4 perm : total=%d B1=%d (expect 24/6)%n",
        length(P), n1(P)).
t03() =>
    X :: 1..3, Y :: 1..3, Z :: 1..3,
    subcircuit_test([X, Y, Z], By),
    P = findall(By, solve([X, Y, Z, By])),
    printf("03 subcircuit 3v1..3   : total=%d B1=%d (expect 27/6)%n",
        length(P), n1(P)).

% -- t04..t08:  oracle comparisons on the triangle ---------------------
% oracle side:  enumerate the original global;  reif side:  fresh
% dvars + caller-made aux arrays,  solve over dvars + aux,  keep the
% B = 1 keys,  dedupe,  and compare the sets.
t04() =>
    V1 :: 0..1, V2 :: 0..1, V3 :: 0..1,
    X1 :: 0..1, X2 :: 0..1, X3 :: 0..1,
    Vs = [{a, V1}, {b, V2}, {c, V3}],
    Es = [{a, b, X1}, {b, c, X2}, {a, c, X3}],
    acyclic(Vs, Es),
    OK = findall({V1, V2, V3, X1, X2, X3}, solve([V1, V2, V3, X1, X2, X3])),
    len(OK) = NOK,
    U1 :: 0..1, U2 :: 0..1, U3 :: 0..1,
    Y1 :: 0..1, Y2 :: 0..1, Y3 :: 0..1,
    B :: 0..1,
    Vs2 = [{a, U1}, {b, U2}, {c, U3}],
    Es2 = [{a, b, Y1}, {b, c, Y2}, {a, c, Y3}],
    T = new_array(3),
    T :: 0..3,
    acyclic_reif_t(Vs2, Es2, T, B),
    P0 = findall({U1, U2, U3, Y1, Y2, Y3, B}, solve({U1, U2, U3, Y1, Y2, Y3, B, T})),
    b1_7t(P0) = B1L,
    sort_uniq(B1L) = S1,
    sort_list(OK) = S0,
    (S1 = S0 -> SS = 1 ; SS = 0),
    printf("04 acyclic oracle      : ref=%d sets_same=%d (expect 17, 1)%n",
        NOK, SS).
t05() =>
    V1 :: 0..1, V2 :: 0..1, V3 :: 0..1,
    X1 :: 0..1, X2 :: 0..1, X3 :: 0..1,
    Vs = [{a, V1}, {b, V2}, {c, V3}],
    Es = [{a, b, X1}, {b, c, X2}, {a, c, X3}],
    acyclic_d(Vs, Es),
    OK = findall({V1, V2, V3, X1, X2, X3}, solve([V1, V2, V3, X1, X2, X3])),
    len(OK) = NOK,
    U1 :: 0..1, U2 :: 0..1, U3 :: 0..1,
    Y1 :: 0..1, Y2 :: 0..1, Y3 :: 0..1,
    B :: 0..1,
    Vs2 = [{a, U1}, {b, U2}, {c, U3}],
    Es2 = [{a, b, Y1}, {b, c, Y2}, {a, c, Y3}],
    T = new_array(3),
    T :: 0..3,
    acyclic_d_reif_t(Vs2, Es2, T, B),
    P0 = findall({U1, U2, U3, Y1, Y2, Y3, B}, solve({U1, U2, U3, Y1, Y2, Y3, B, T})),
    b1_7t(P0) = B1L,
    sort_uniq(B1L) = S1,
    sort_list(OK) = S0,
    (S1 = S0 -> SS = 1 ; SS = 0),
    printf("05 acyclic_d oracle    : ref=%d sets_same=%d (expect 18, 1)%n",
        NOK, SS).
main() =>
    t04(), t05(), t01(), t02(), t03().
