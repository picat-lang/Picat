  % User-defined functions in SAT constraints - deep integration via sat2 ONLY.
  %
  %   PICATPATH=lib timeout 600 emu/picat exs/sat/sat2_udf_native.pi   (from the repo root)
  %
  % One import, no lib2/udf, no operator shim, no include.  sat2's own
  % constraint operators,  solve  objectives,  udf_post  and
  % udf_evaluate  expand registered user functions automatically.
  % Demonstrates:
  %
  %   1) udf in a bare  #=            (natural style, no boilerplate)
  %   2) compound udf                 ($cost calls $sq)
  %   3) structural recursion         ($total/1, base + recursive clauses)
  %   4) udf in a reified constraint  (SAT-specific)
  %   5) udfs combined with  #\/
  %   6) udf negated with  #~
  %   7) udf_post for explicit posting of (flattened) relations
  %   8) udf_evaluate for ground evaluation
  %   9) udfs in the  $min/$max  objective of  solve
  %
  % Notes (empirically observed in this 3.9#12 build):
  %   * udf_define parameters are live variables:  register_udfs/0  scopes
  %     them into a helper predicate so  main  can reuse any variable name
  %     (a  not(not(...))  wrapper would not work - the negation rolls the
  %     heap-map registration back).
  %   * $f(X) op $g(Y)  (two $-quoted calls around an operator) does not
  %     parse; parenthesize each reified side (see 5 and 6).
  %   * println is  println(Term)  or  println(FD, Term)  where FD is a
  %     file-descriptor integer - the multi-value output below therefore
  %     uses  printf.

  import sat2.

  % ---- register the user functions (global heap-map registry) ----
  register_udfs() =>
      udf_define($inc(N), $(N + 1)),
      udf_define($sq(U), $U * U),
      udf_define($cost(P, K), $(P * K + sq(P))),       % compound: calls sq
      udf_define($total([]), 0),                        % structural recursion
      udf_define($total([H | T]), $(H + total(T))).

  main =>
      register_udfs(),

      % ---- 1) natural style: udf in a bare  #=  ----
      X :: 0..10,
      $inc(X) #= 6,
      solve([X]),
      printf("1) $inc(X) #= 6              => X = %w%n", X),

      % ---- 2) compound udf ----
      V :: 0..100,
      V #= $cost(3, 2),
      solve([V]),
      printf("2) V #= $cost(3, 2)         => V = %w%n", V),

      % ---- 3) structurally recursive udf ----
      R :: 0..100,
      10 #= $total([1, R, 3]),
      solve([R]),
      V3 = udf_evaluate($total([1, R, 3])),
      printf("3) 10 #= $total([1,R,3])    => R = %w (evaluate = %w)%n", R, V3),

      % ---- 4) udf in a reified constraint (SAT-specific) ----
      A :: 0..4,
      B :: 0..1,
      B #<=> $sq(A) #>= 4,
      solve_all([A, B]) = S,
      printf("4) B #<=> $sq(A) #>= 4      => %w%n", S),

      % ---- 5) udfs combined with boolean operators ----
      U :: 0..3,
      ($sq(U) #= 1) #\/ ($sq(U) #= 4),
      solve_all([U]) = S5,
      printf("5) (sq(U)=1) #\\/ (sq(U)=4) => %w%n", S5),

      % ---- 6) negated udf ----
      W :: 0..3,
      #~($sq(W) #= 1),
      solve_all([W]) = S6,
      printf("6) #~(sq(W) #= 1)           => %w%n", S6),

      % ---- 7) explicit posting of a relation with udf arguments ----
      Z :: 0..10,
      udf_post('#=', $sq(Z), 9),
      solve([Z]),
      printf("7) udf_post('#=', $sq(Z), 9) => Z = %w%n", Z),

      % ---- 8) ground evaluation of nested udfs ----
      V8 = udf_evaluate($inc($sq(4)) + 1),
      printf("8) $inc($sq(4)) + 1         = %w%n", V8),

      % ---- 9) udfs in the objective function of  solve  ($min/$max) ----
      O :: 0..5,
      solve([$max($sq(O))], [O]),
      printf("9) max $sq(O) over 0..5      => O = %w%n", O).
