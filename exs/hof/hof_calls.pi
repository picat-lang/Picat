/* New in Picat 4.0b19-4.0b24:

   - Higher-order variable calls: a variable at compile time can hold
     a function or predicate name (or any callable term) and be
     called: S(A1,...,An).  The call can also be module-qualified:
     m.S(...) invokes the function defined in module m whose symbol
     is referenced by S.

   - Anonymous functions and predicates: ([A1,...,An] -> Body) and
     ([A1,...,An] => Body), with capture at creation. */

main =>
    % higher-order variable calls
    F = sqrt,             % a builtin function name in a variable
    writeln(F(16)),       % 4.0 -- called like any function
    writeln(math.F(16)),  % module-qualified: math.sqrt(16)
    G = length,
    writeln(G("picat")),  % 5
    H = abs,
    writeln(H(-42)),      % 42
    % anonymous functions and predicates (capture at creation)
    Sq = ([X] -> X*X),
    writeln(Sq(7)),       % 49
    K = 10,
    AddK = ([X] -> X+K),  % K is captured when AddK is created
    writeln(AddK(5)),     % 15
    Pr = ([X] => writeln(X)),
    Pr(42).               % 42
