import sat.
import aspic_runtime.
var(X,_)=X.
range(_,_)=0.
'#='(L,R)  => sat.'#='(aspic_flatten(L), aspic_flatten(R)).
capacity(5)=1.
capacity(_)=0.
item(1,3,15)=1.
item(2,5,20)=1.
item(3,2,14)=1.
item(_,_,_)=0.
sel(X1)=aspic_var($sel(X1)).
main=>aspic_udf_init(),ASPIC_SEARCH:=sat,
aspic_startlearning(),
% {1}	item(1,3,15).
aspic_debug("{1}	item(options([[1,3,15]]))"),
aspic_markfact($item(1,3,15)),
% {2}	item(2,5,20).
aspic_debug("{2}	item(options([[2,5,20]]))"),
aspic_markfact($item(2,5,20)),
% {3}	item(3,2,14).
aspic_debug("{3}	item(options([[3,2,14]]))"),
aspic_markfact($item(3,2,14)),
% {4}	capacity(5).
aspic_debug("{4}	capacity(options([[5]]))"),
aspic_markfact($capacity(5)),
% {5}	{sel(I)}:-item(I,_,_).
aspic_debug("{5}	aspic_impl(item(options([[var(I,[]),var(ARANGE2,[]),var(ARANGE3,[])]])),aspic_card(set(sel(options([[var(I,[])]])))))"),
_=[aspic_fholds(aspic_impl(item(I,ARANGE2,ARANGE3),aspic_card([sel(I)]))):
I in aspic_instances(item,3,1),ARANGE2 in aspic_instances(item,3,2),ARANGE3 in aspic_instances(item,3,3)
],
aspic_stoplearning(),
% {6}	:-capacity(C),#sum{W:sel(I),item(I,W,_)}>C.
aspic_debug("{6}	aspic_not(aspic_conj([capacity(options([[var(C,[])]])),aspic_gt(aspic_agval(sum,valset([var(W,[])],aspic_conj([sel(options([[var(I,[])]])),item(options([[var(I,[]),var(W,[]),var(ARANGE4,[])]]))]))),var(C,[]))]))"),
_=[aspic_fholds(aspic_not(aspic_conj([capacity(C),aspic_gt(aspic_sum([W3 : W in aspic_instances(item,3,2),I in aspic_instances(sel,1,1),ARANGE4 in aspic_instances(item,3,3), WC = aspic_conj([sel(I),item(I,W,ARANGE4)]), W3 #= cond(WC, W, 0)]),C)]))):
C in universe()
],
aspic_stoplearning(),
H=get_heap_map(aspic_m(aspic_atoms)),M2=get_heap_map(aspic_m(aspic_asserted)),
foreach(ASPIC_ATOM in H.keys())
if(not aspic_isfdvariable(ASPIC_ATOM),not(M2.has_key(ASPIC_ATOM)))
L=[]
++[1:_ in 1..1,ASPIC_ATOM=$item(1,3,15)]
++[1:_ in 1..1,ASPIC_ATOM=$item(2,5,20)]
++[1:_ in 1..1,ASPIC_ATOM=$item(3,2,14)]
++[1:_ in 1..1,ASPIC_ATOM=$capacity(5)]
++[item(I,ARANGE2,ARANGE3):_ in 1..1,ASPIC_ATOM=$sel(I),I in aspic_instances(item,3,1),ARANGE2 in aspic_instances(item,3,2),ARANGE3 in aspic_instances(item,3,3),I in aspic_instances(item,3,1)]
,L2=aspic_disj(L)
,if(not(L2==1)) then
aspic_holds(aspic_impl(H.get(ASPIC_ATOM),aspic_disj(L))),
end
end
end,
ASPIC_OPT#=$suml([$when(WC, V) : V in aspic_instances(item,3,3),I in aspic_instances(sel,1,1),ARANGE1 in aspic_instances(item,3,2),WC = aspic_conj([sel(I),item(I,ARANGE1,V)])]),aspic_solve_dir(max),
aspic_solve(ASPIC_SEARCH,ASPIC_OPT,max)
.
