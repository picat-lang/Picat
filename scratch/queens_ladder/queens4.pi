import sat.
import aspic_runtime.
var(X,_)=X.
range(_,_)=0.
'#='(L,R)  => sat.'#='(aspic_flatten(L), aspic_flatten(R)).
q(X1,X2)=aspic_var($q(X1,X2)).
main=>aspic_udf_init(),ASPIC_SEARCH:=sat,
aspic_startlearning(),
% {1}	{q(I,1..n)}==1:-I=1..n.
aspic_debug("{1}	aspic_impl(aspic_eq(var(I,[]),var(ARANGE2,range(1,4))),aspic_card(set(q(options([[var(I,[]),var(ARANGE1,range(1,4))]]))),1,1))"),
_=[aspic_fholds(aspic_card([q(I,ARANGE1):ARANGE1 in 1..4],1,1)):
I in 1..4
],
% {2}	{q(1..n,J)}==1:-J=1..n.
aspic_debug("{2}	aspic_impl(aspic_eq(var(J,[]),var(ARANGE4,range(1,4))),aspic_card(set(q(options([[var(ARANGE3,range(1,4)),var(J,[])]]))),1,1))"),
_=[aspic_fholds(aspic_card([q(ARANGE3,J):ARANGE3 in 1..4],1,1)):
J in 1..4
],
aspic_stoplearning(),
% {3}	:-{q(D-J,J)}>=2,D=2..2*n.
aspic_debug("{3}	aspic_not(aspic_conj([aspic_card(set(q(options([[aspic_diff(var(D,[]),var(J,[])),var(J,[])]]))),2,[]),aspic_eq(var(D,[]),var(ARANGE5,range(2,aspic_mul(2,4))))]))"),
_=[aspic_fholds(aspic_not(aspic_conj([aspic_card([q(aspic_diff(D,J),J):J in 1..4],2,[]),1]))):
D in 2..aspic_mul(2,4)
],
% {4}	:-{q(D+J,J)}>=2,D=1-n..n-1.
aspic_debug("{4}	aspic_not(aspic_conj([aspic_card(set(q(options([[aspic_sum(var(D,[]),var(J,[])),var(J,[])]]))),2,[]),aspic_eq(var(D,[]),var(ARANGE6,range(aspic_diff(1,4),aspic_diff(4,1))))]))"),
_=[aspic_fholds(aspic_not(aspic_conj([aspic_card([q(aspic_sum(D,J),J):J in 1..4],2,[]),1]))):
D in aspic_diff(1,4)..aspic_diff(4,1)
],
aspic_stoplearning(),
H=get_heap_map(aspic_m(aspic_atoms)),M2=get_heap_map(aspic_m(aspic_asserted)),
foreach(ASPIC_ATOM in H.keys())
if(not aspic_isfdvariable(ASPIC_ATOM),not(M2.has_key(ASPIC_ATOM)))
L=[]
++[1:_ in 1..1,ASPIC_ATOM=$q(I,ARANGE1),I in 1..4,ARANGE1 in 1..4]
++[1:_ in 1..1,ASPIC_ATOM=$q(ARANGE3,J),ARANGE3 in 1..4,J in 1..4]
,L2=aspic_disj(L)
,if(not(L2==1)) then
aspic_holds(aspic_impl(H.get(ASPIC_ATOM),aspic_disj(L))),
end
end
end,
ASPIC_OPT#=0,
aspic_solve(ASPIC_SEARCH,ASPIC_OPT,min)
.
