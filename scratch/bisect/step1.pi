%% step1.pi -- bisect: the working t.pi with ONLY the objective line replaced
%% by the udf $suml form (shim + import udf added). Everything else unchanged.
import sat.
import udf.
import aspic_runtime.
var(X,_)=X.
range(_,_)=0.
capacity(5)=1.
capacity(_)=0.
item(1,3,15)=1.
item(2,5,20)=1.
item(3,2,14)=1.
item(_,_,_)=0.
sel(X1)=aspic_var($sel(X1)).
'#='(L,R)  => sat.'#='(udf.flatten(L), udf.flatten(R)).
aspic_udf_init =>
    udf.define($when(C,V),   $(cond(C,V,0))),
    udf.define($suml([]), 0),
    udf.define($suml([H|T]), $(H + suml(T))).
main=>ASPIC_SEARCH:=sat,
aspic_udf_init(),
aspic_startlearning(),
aspic_markfact($item(1,3,15)),
aspic_markfact($item(2,5,20)),
aspic_markfact($item(3,2,14)),
aspic_markfact($capacity(5)),
_=[aspic_fholds(aspic_impl(item(I,ARANGE2,ARANGE3),aspic_card([sel(I)]))):
I in aspic_instances(item,3,1),ARANGE2 in aspic_instances(item,3,2),ARANGE3 in aspic_instances(item,3,3)
],
aspic_stoplearning(),
H=get_heap_map(aspic_m(aspic_atoms)),M2=get_heap_map(aspic_m(aspic_asserted)),
foreach(ASPIC_ATOM in H.keys())
if(not aspic_isfdvariable(ASPIC_ATOM),not(M2.has_key(ASPIC_ATOM)))
L=[]
++[1:_ in 1..1,ASPIC_ATOM=$item(1,3,15)]
++[1:_ in 1..1,ASPIC_ATOM=$item(2,5,20)]
++[1:_ in 1..1,ASPIC_ATOM=$item(3,2,14)]
++[1:_ in 1..1,ASPIC_ATOM=$capacity(5)]
++[item(I,ARANGE2,ARANGE3):_ in 1..1,ASPIC_ATOM=$sel(I),I in aspic_instances(item,3,1),ARANGE2 in aspic_instances(item,3,2),ARANGE3 in aspic_instances(item,3,3),I in aspic_instances(item,3,1)]
,L2=aspic_disj(L)
,if(not(L2==1)) then
aspic_holds(aspic_impl(H.get(ASPIC_ATOM),aspic_disj(L))),
end
end
end,
ASPIC_OPT #= $suml([$when(WC, V) : V in aspic_instances(item,3,3), I in aspic_instances(sel,1,1), AR1 in aspic_instances(item,3,2), WC = aspic_conj([sel(I), item(I,AR1,V)])]),aspic_solve_dir(max),
aspic_solve(ASPIC_SEARCH,ASPIC_OPT,max)
.
