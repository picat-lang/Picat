%run with picat picasp.pi filename
import aspic_runtime.
main=>asp
%id, weight, value
item(1,3,15).
item(2,5,20).
item(3,2,14).
capacity(5).
{sel(I)}:-item(I,_,_).
:-capacity(C),#sum{W:sel(I),item(I,W,_)}>C.
#maximize{V,I:sel(I),item(I,_,V)}.
end,
aspic_solve_sub(),
writeln([I:I in 1..3,A=sel(I),A=1]).
