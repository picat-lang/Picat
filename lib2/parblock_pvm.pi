% parblock_pvm:  the PVM mode-2 (process-parallel) backend for the
% parblock par_run contract.
%
%   par_run(NT, Tasks) = Rs
%       NT = 0:  falls back to the phase-0 serial  par_run(Tasks).
%       NT >= 1:  forks NT processes over the M task indices 1..M
%                 (the mode-2 split, queens_count style),  every
%                 task runs exactly once in some worker,  the root
%                 collects,  and returns the results in task order.
%
% Contract (==  parblock.par_run,  async-refined exactly like 1a):
%   - Rs is in TASK order,  independent of NT and of which worker
%     ran which chunk (index-tagged reports,  root reassembles).
%   - A task exception aborts the whole par,  like a failing
%     conjunct:  the caller sees the FIRST throwing task's
%     exception term,  identical to the serial par_run term.
%   - Async divergence vs serial,  documented:  in serial,  tasks
%     after the first thrower never run;  in mode 2 they MAY run in
%     their workers (side effects of post-thrower tasks are not
%     suppressed).  The exception term and its task order are the
%     guaranteed part.
%
% Task names:  F in  {F}  /  {F, A}  must be UNQUALIFIED references
% visible in the calling program;  a module-QUALIFIED dynamic
% dispatch of a function hangs (engine bug (a),  docs/
% pvmbugs_report.tex,  repros q1/q2.pi).  Cross-module unqualified
% dispatch is verified (scratch/reif/parblock/dynpvm.pi).
%
% Substrate notes carried over from 1a's triage (docs/
% pvmbugs_report.tex):
%   - mode 2 has no call_cleanup/delegate windows,  so the codec
%    truncation (bug b) and the in-window search hang (bug c) do
%    not apply;  the {I, R}  /  {I, {err, E}}  index-tagged TUPLE
%    reports are used regardless (tuples round-trip exactly).
%  - every mode-2 process runs the SAME program:  a worker that
%    returned from this function would go on executing the CALLER'S
%    code with unbound session vars.  The worker branch therefore
%    halts after its report;  the collect on the root is clean
%    (scratch/reif/parblock/nd4.pi).
%  - the error term E travels through the codec as a ground term;
%    a task exception that is not ground cannot be reported (same
%    bad-flag risk as 1a's ground(V) guard).
%
% ================ mode 1 (portfolio race) backends ================
%
%   race(NT, F, Xs) = P          P = (W, Y)
%   race_res(NT, F, Xs) = S      S = [won, W, Y]  |  exhausted
%   map_par(NT, F, Xs) = Ys      ordered parallel map
%   map_race(NT, Fs, Xs) = Ys    per-X portfolio race over Fs
%   par_any(NT, P, Xs) = S       S = [sat, X]  |  none
%   par_all(NT, P, Xs) = S       S = ok  |  [fail, X]
%
%  Substrate (emu/parvm.c, the 1a battery
%  exs/parallel/parblock/parblock_pvm_race.pi):  the engine forks
%  children AT CHOICE POINTS under the pool size NT (the current
%  process keeps the first disjunct,  a child takes the rest);  a
%  candidate's inner search is wrapped in the bp.pvm_delegate(1/0)
%  window,  making its frames eligible for pool forking;  the first
%  process to complete a candidate reports BY VALUE (the codec is
%  exact for tuples / arrays of ground terms,  truncated for lists
%  consed from window-exit values -- bug b -- hence the index-tagged
%  (I, V) tuple reports);  the others notice the found flag at their
%  next choice point and exit;  the root collects (R = 1/0) and
%  materializes the winner (bp.pvm_solution).
%
%  Discipline (all pinned in the 1a battery,  docs/
%  pvmbugs_report.tex + the probe notes here):
%   - the root NEVER calls bp.pvm_worker_id in a mode-1 session
%     (segments;  the 1a battery does not call it either);
%   - a candidate that cannot complete must THROW inside the window
%     (a plain clause failure in the window hangs the session at
%     collect -- bug c);  function candidates are total by language
%     semantics:  a function call with no matching rule THROWS
%     (never silently fails);
%   - a report is guarded by ground(...) (1a's ground(V) guard);
%   - a root-level exception DURING a live mode-1 session is not a
%     supported path (it leaves the session dirty:  the next
%     pvm_fork in the process is rejected and orphaned children
%     interleave their output).  Every family member therefore
%     routes every possible throw onto a supported path before the
%     root may throw:  par_all is a mode-2 session (task-error
%     reports,  rethrown by the root AFTER collect,  exactly like
%     par_run),  map_race throws $parblock_mrace_empty(X)
%     only after its element session has collected.
%
%  Async refinement of the phase-0 written-order schedule (1a rule):
%  the reported winner is the first candidate that COMPLETES in
%  wall-clock time (the root's written-order walk is the bias,  not
%  a guarantee);  the guaranteed part is that the winner is a
%  genuine completer with an exact value.
%
%  NT = 0 falls back to the phase-0 serial combinator.

module parblock_pvm.
import parblock.

par_run(NT, Tasks) = Rs =>
    M = len(Tasks),
    pvp1(NT, M, Tasks, Rs).

pvp1(0, M, Tasks, Rs) =>
    Rs = parblock.par_run(Tasks).

pvp1(NT, M, Tasks, Rs) =>
    ( M = 0, Rs = []
    ;
      ( bp.pvm_fork(NT, 2, M),
        bp.pvm_worker_id(I),
        ( I > 0,
          bp.pvm_chunk(Lo, Hi),
          pvpreps(Hi, Lo, Tasks, [], Reps),
          bp.pvm_report(Reps),
          halt
        ;
          ( bp.pvm_collect(ChunkReps),
            pvpflat(ChunkReps, [], Pairs),
            len(Pairs) = M,
            pvpdone(Pairs, M, Rs) ) ) ) ).

% worker:  every task index in [Lo..Hi],  the value or the wrapped
% exception,  tagged with the task index.
pvpreps(Hi, I, Tasks, Acc, Reps) =>
    ( I > Hi, Reps = Acc
    ;
      ( pvpnth(I, Tasks, T),
        catch( (R = pvptask(T), P = {I, R}),
               E,
               P = {I, {err, E}} ),
        pvpreps(Hi, I + 1, Tasks, [P | Acc], Reps) ) ).

pvpnth(1, [H | _], T) => T = H.
pvpnth(I, [_ | Ts], T) => I > 1, pvpnth(I - 1, Ts, T).

% task dispatch,  kept local to this module (a module-qualified
% dynamic call/apply whose target compiles to a function hangs --
% engine bug (a);  an unqualified same-call apply is clean).
pvptask({F})    = apply(F).
pvptask({F, A}) = apply(F, A).

% root:  flatten the per-chunk reports (chunks arrive in worker
% order,  NOT necessarily task order --  reassembly is by index).
pvpflat([], Acc, Pairs) => Pairs = Acc.
pvpflat([R | Rs], Acc, Pairs) => pvpflat(Rs, Acc ++ R, Pairs).

% root:  index the pairs,  scan in task order for the first
% exception and rethrow it (contract:  a task exception aborts the
% par);  otherwise return the values in task order.
pvpdone(Pairs, M, Rs) =>
    A = new_array(M),
    foreach (P in Pairs)
        A[first(P)] = second(P)
    end,
    E = pvperr(1, M, A),
    ( E = $noerr, Rs = [A[I] : I in 1..M]
    ; throw(E) ).

pvperr(I, M, A) = E =>
    ( I > M, E = $noerr
    ;
      ( V = A[I],
        ( V = {err, E2}, E = E2
        ; pvperr(I + 1, M, A) = E ) ) ).

% ====================================================================
%  mode 1 (portfolio race) backends
% ====================================================================

% -------------------------- race / race_res ------------------------

race(NT, F, Xs) = P =>
    race_res(NT, F, Xs) = S,
    S = [won, W, Y],
    P = (W, Y).

race_res(NT, F, Xs) = S =>
    M = len(Xs),
    pvrr1(NT, M, F, Xs, S).

pvrr1(0, M, F, Xs, S) =>
    S = parblock.race_res(F, Xs).

pvrr1(NT, M, F, Xs, S) =>
    ( M = 0, S = exhausted
    ;
      ( bp.pvm_fork(NT, 1, 1),
        pvwalkr(F, 1, M, Xs, V),
        bp.pvm_collect(R),
        ( R = 1,
          bp.pvm_solution(S0),
          S0 = (W, Y),
          S = [won, W, Y]
        ;
          S = exhausted ) ) ).

% the candidate walk;  the choice point of this disjunction is a
% fork site (the current process keeps clause I,  a pool child takes
% I+1..M);  when the pool is saturated the root walks on itself.
pvwalkr(F, I, M, Xs, V) =>
    ( I > M, true
    ;
      ( pvcl_r(F, Xs[I], V) ; pvwalkr(F, I + 1, M, Xs, V) ) ).

pvcl_r(F, X, V) =>
    bp.pvm_delegate(1),
    call_cleanup(catch(pvst_r(F, X, V), E, false), bp.pvm_delegate(0)),
    ground(V),
    bp.pvm_report((X, V)).

% total-or-throw:  a function call with no matching rule already
% throws,  so this strategy either reports a value or throws away.
pvst_r(F, X, V) =>
    ( apply(F, X) = V
    ; throw($parblock_race_drop(X)) ).

% ---------------------------- par_any -----------------------------

par_any(NT, P, Xs) = S =>
    M = len(Xs),
    pvpa1(NT, M, P, Xs, S).

pvpa1(0, M, P, Xs, S) =>
    S = parblock.par_any(P, Xs).

pvpa1(NT, M, P, Xs, S) =>
    ( M = 0, S = none
    ;
      ( bp.pvm_fork(NT, 1, 1),
        pvwalka(P, 1, M, Xs),
        bp.pvm_collect(R),
        ( R = 1,
          bp.pvm_solution(W),
          S = [sat, W]
        ;
          S = none ) ) ).

pvwalka(P, I, M, Xs) =>
    ( I > M, true
    ;
      ( pvcl_a(P, Xs[I]) ; pvwalka(P, I + 1, M, Xs) ) ).

% a throwing P(X) drops out (the serial contract);  so does a plain
% failure,  converted to a throw so the window never clause-fails.
pvcl_a(P, X) =>
    bp.pvm_delegate(1),
    call_cleanup(catch(pvst_a(P, X), E, false), bp.pvm_delegate(0)),
    ground(X),
    bp.pvm_report(X).

pvst_a(P, X) =>
    ( once(call(P, X))
    ; throw($parblock_any_drop(X)) ).

% ---------------------------- map_par -----------------------------

% ordered parallel map:  one task per element,  mode-2 partition,
% results in element order (par_run semantics:  a throwing F(X)
% aborts the par with the first throwing element's term,  in
% element order).
map_par(NT, F, Xs) = Ys =>
    Tasks = [{F, X} : X in Xs],
    par_run(NT, Tasks) = Ys.

% ---------------------------- par_all -----------------------------

% fail-fast over the elements.  Mode 2 (NOT the mode-1 portfolio):
% the elements must all be TESTED to find the first failure,  and a
% throwing P(X) must propagate with its element order -- that is
% exactly par_run's error-report machinery,  reassembled with
% par_all's resolution:  scan the {I, R} reports in element order;
% the first {fail, X} wins (a later error is never seen,  exactly
% like the serial fail-fast);  the first {err, E} before any failure
% is rethrown;  all ok -> ok.
% Documented async divergence:  elements AFTER the first failure may
% still run in their workers (side effects are not suppressed),  as
% in par_run;  the returned term is the serial one.

par_all(NT, P, Xs) = S =>
    M = len(Xs),
    pval1(NT, M, P, Xs, S).

pval1(0, M, P, Xs, S) =>
    S = parblock.par_all(P, Xs).

pval1(NT, M, P, Xs, S) =>
    ( M = 0, S = ok
    ;
      ( bp.pvm_fork(NT, 2, M),
        bp.pvm_worker_id(I),
        ( I > 0,
          bp.pvm_chunk(Lo, Hi),
          pvalreps(Hi, Lo, P, Xs, [], Reps),
          bp.pvm_report(Reps),
          halt
        ;
          ( bp.pvm_collect(ChunkReps),
            pvalflat(ChunkReps, [], Pairs),
            len(Pairs) = M,
            pvalresolve(Pairs, M, S) ) ) ) ).

% worker:  the per-element verdict,  value or wrapped exception,
% tagged with the element index.
pvalreps(Hi, I, P, Xs, Acc, Reps) =>
    ( I > Hi, Reps = Acc
    ;
      ( catch( (R = pvaltest(P, Xs[I]), Q = {I, R}),
               E,
               Q = {I, {err, E}} ),
        pvalreps(Hi, I + 1, P, Xs, [Q | Acc], Reps) ) ).

% total-or-throw:  P succeeds -> ok,  P fails -> {fail, X},  P
% throws -> propagates (reported as {err, E} by the wrapper above).
pvaltest(P, X) = R =>
    ( once(call(P, X)), R = ok
    ;
      R = {fail, X} ).

pvalflat([], Acc, Pairs) => Pairs = Acc.
pvalflat([R | Rs], Acc, Pairs) => pvalflat(Rs, Acc ++ R, Pairs).

pvalresolve(Pairs, M, S) =>
    A = new_array(M),
    foreach (Q in Pairs)
        A[first(Q)] = second(Q)
    end,
    pvalscan(1, M, A, S).

pvalscan(I, M, A, S) =>
    ( I > M, S = ok
    ;
      ( Q = A[I],
        ( Q = {fail, X}, S = [fail, X]
        ;
          ( Q = {err, E}, throw(E)
          ; pvalscan(I + 1, M, A, S) ) ) ) ).

% --------------------------- map_race ------------------------------

% per-element mode-1 portfolio race over the function list Fs:
% the serial outer loop keeps the element order (and the result
% list order);  each element is one self-contained session (a
% session always unwinds through collect,  so back-to-back sessions
% are clean -- the q4 precedent,  docs/pvmbugs_report.tex).
% All F throw for an element -> $parblock_mrace_empty(X),  thrown
% AFTER the element session has collected (supported throw point).

map_race(NT, Fs, Xs) = Ys =>
    Ys = pvmrcall(NT, Fs, Xs).

pvmrcall(NT, Fs, []) = [].
pvmrcall(NT, Fs, [X | Xs]) = [Y | Ys] =>
    pvmrc1(NT, Fs, X) = Y,
    pvmrcall(NT, Fs, Xs) = Ys.

pvmrc1(0, Fs, X) = Y =>
    parblock.map_race(Fs, [X]) = [Y].

pvmrc1(NT, Fs, X) = Y =>
    M = len(Fs),
    bp.pvm_fork(NT, 1, 1),
    pvwalkm(Fs, X, 1, M, V),
    bp.pvm_collect(R),
    ( R = 1,
      bp.pvm_solution(S0),
      S0 = (_F, Y)
    ;
      throw($parblock_mrace_empty(X)) ).

pvwalkm(Fs, X, I, M, V) =>
    ( I > M, true
    ;
      ( pvcl_m(Fs, X, I, V) ; pvwalkm(Fs, X, I + 1, M, V) ) ).

pvcl_m(Fs, X, I, V) =>
    bp.pvm_delegate(1),
    call_cleanup(catch(pvst_m(Fs, X, I, V), E, false), bp.pvm_delegate(0)),
    ground(V),
    bp.pvm_report((I, V)).

pvst_m(Fs, X, I, V) =>
    ( apply(Fs[I], X) = V
    ; throw($parblock_mr_drop(I)) ).
% ====================================================================
%  race block forms  (phase 2)
% ====================================================================
%
%  The statement-level form of the mode-1 portfolio race:  the
%  candidates are the clauses of a user-written disjunction between
%  race_begin / race_end  instead of the {F, X}  pairs of race_res.
%
%   race_begin(NT)    opens a mode-1 portfolio session (the same
%                     substrate as race_res above).
%                     NT = 0:  a POOL-1 session --  no child is ever
%                     forked  (the pool holds the single process),
%                     the root walks the clauses in written order,
%                     and the first clause to complete is the first
%                     to report:  exactly the phase-0 serial
%                     written-order race contract.
%                     NT >= 1:  the portfolio (children take the
%                     remaining clauses at the body's choice points).
%   race_cl(I, F)     one clause of the block body;
%   race_cl(I, F, A)  F()  /  F(A)  must complete with a GROUND
%                     value.  A candidate that throws or fails drops
%                     out (total-or-throw,  the clause discipline of
%                     this family);  I is the clause's written
%                     position and becomes the winner identity.
%   race_end(R)       R = [won, I, V]:  the winning clause (first
%                     completer) and its value,  carried BY VALUE in
%                     the pool report,  so the clauses need no
%                     shared value variable.  Every clause dropped
%                     out ->  throw($parblock_raceb_empty),  thrown
%                     only after the session unwound through collect
%                     (a supported throw point,  the map_race
%                     precedent;  the exception analogue of the
%                     family's exhausted value).
%
%  Shape (the body must be exactly this):
%
%    parblock_pvm.race_begin(4),
%    ( parblock_pvm.race_cl(1, sol_a)
%    ; parblock_pvm.race_cl(2, sol_b)
%    ; true ),
%    parblock_pvm.race_end(R).
%
%    The trailing  true  disjunct is REQUIRED:
%      - for the ROOT it is the exhaustion / found landing  (the
%        pvwalkr base case  I > M, true  and 1a's  ( model ; true )
%        cut):  when a child wins,  the root's remaining clauses
%        drop out at their next choice points,  the walk lands on
%        true,  and the block flows into race_end;
%      - for a POOL CHILD that has run out of its own clauses,  it
%        is the fall-through into race_end,  where the engine
%        handles it natively:  a mode-1 fork child reaching
%        bp.pvm_collect  exits the process (pvm_worker_exit,
%        noreturn)  --  the child never materializes,  and no child
%        state ever needs to be shared,  which is why this form
%        keeps NO mode flag and NO session list (a global map is
%        not readable from a forked child's continuation,  and the
%        root's own map state corrupts after a session that
%        forked children:  groupd_term_expected).
%
%  The winner is a MODEL (the satext rule):  validate V against the
%  winning clause's contract;  never assert which clause won (I is
%  a scheduling outcome).
%
%  Constraints:
%    - no nesting (one live block per process,  like a session);
%    - the body sits exactly between begin and end;
%    - task names follow the family rule:  UNQUALIFIED
%      module-visible references (a module-qualified dynamic
%      dispatch of a function is engine bug (a));
%    - a root-level exception DURING a live session is not a
%      supported path (as for the family):  race_cl routes every
%      throw onto a supported path,  and race_end throws only after
%      its collect;
%    - race_cl / race_end outside a block are not wrapped:  the
%      unarmed  bp.pvm_report  /  bp.pvm_collect  raise the engine's
%      illegal_arguments error;
%    - the task-parallel block form  par_begin / par_end  still
%      needs a C pool mode (a run-all-disjuncts partition plus a
%      multi-report collect);  see the note in parblock.pi.

race_begin(NT) =>
    ( NT > 0, bp.pvm_fork(NT, 1, 1)
    ; bp.pvm_fork(1, 1, 1) ).

race_cl(I, F) =>
    racebcl(I, F, parblock_raceb_narg).

race_cl(I, F, A) =>
    racebcl(I, F, A).

%  the clause body,  exactly the pvcl_r shape (proven in the 1c
%  battery):  the per-clause delegate window makes the strategy's
%  frames eligible for pool forking;  the report is by value,
%  tagged with the written clause position.
racebcl(I, F, A) =>
    bp.pvm_delegate(1),
    call_cleanup(catch(racebval(F, A) = V, E, false), bp.pvm_delegate(0)),
    ground(V),
    bp.pvm_report((I, V)).

%  total-or-throw:  a function call with no matching rule throws,  so
%  a candidate either completes with a value or throws away (caught
%  above);  the failing disjunct is unreachable,  kept for the
%  discipline.
racebval(F, parblock_raceb_narg) = V =>
    ( V = apply(F)
    ; throw($parblock_raceb_drop(0)) ).

racebval(F, A) = V =>
    ( V = apply(F, A)
    ; throw($parblock_raceb_drop(A)) ).

race_end(R) =>
    bp.pvm_collect(Rc),
    ( Rc = 1,
      bp.pvm_solution(S0),
      S0 = (I, V),
      R = [won, I, V]
    ;
      throw($parblock_raceb_empty) ).
