% pb: pseudo-Boolean constraints over 0/1 variables, native OPB
% backend.  The constraint store is a per-problem term (no global
% state, nothing leaks across problems); the OPB text is emitted
% directly from it, so a pseudo-Boolean solver (roundingsat) sees the
% linear structure natively -- the pigeon-hole class, where
% clausal encodings are exponential for CDCL solvers, falls in
% milliseconds.
%
% The store:
%   B = pb.new(NVars)              boolean vars numbered 1..NVars
%   B1 = pb.card(B, Rel, K, Idx)   cardinality: all-1 coefficients
%                                  over the indices; Rel in '<=' '>=' '='
%   B1 = pb.lin(B, Rel, K, Terms)  linear: Terms = [[C, I], ...]
%                                  (coefficient C on var I)
% The solve:
%   Model = pb.solve(B)            throws $pb_unsat on unsat/unknown
%   S = pb.solve_res(B)            S = [sat, Model] | unsat | unknown;
%                                  Model = a list of 0/1 per variable
%                                  (the caller binds X = Model[I])
% The solver: env PBSOL (default "roundingsat", PATH-resolved), run
% with --print-sol=1 through satext's raw-file runner (one spec, no
% portfolio: the first-wins race hands the same formula to every
% racer, and CNF racers would need a clausal re-encoding).
%
% Use with:  PICATPATH=<picat>/lib2  picat yourfile.pi

module pb.

import satext, os, datetime.

%%%%%%%%%%%%%%%%%%%%%%%%%%%% the store %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

new(NVars) = {NVars, []}.

card({N, Cs}, Rel, K, Idx) = {N, [$c_card(Rel, K, Idx) | Cs]}.

lin({N, Cs}, Rel, K, Terms) = {N, [$c_lin(Rel, K, Terms) | Cs]}.

%%%%%%%%%%%%%%%%%%%%%%%%%%%% the solve %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

solve(B) = Model =>
    S = solve_res(B),
    ( S = [sat, Model] -> true ; throw($pb_unsat) ).

solve_res({N, Cs}) = S =>
    Path = opb_path(),
    call_cleanup(go_res(N, Cs, Path, S), rm_path(Path)).

rm_path(Path) => os.rm(Path.to_atom()).

go_res(N, Cs, Path, S) =>
    write_opb(N, Cs, Path),
    ( os.env_exists("PBSOL") -> Sol = os.getenv("PBSOL") ; Sol = "roundingsat" ),
    Spec = [Sol, "--print-sol=1", Path],
    satext.run_file(Spec, N, St, M),
    ( St = sat -> S = [sat, M]
    ; St = unsat -> S = unsat
    ; S = unknown ).

%%%%%%%%%%%%%%%%%%%%%%%% the OPB text writer %%%%%%%%%%%%%%%%%%%%%%%%%

% a fresh temp path.  The directory: the first candidate that exists
% AND is writable at runtime -- /dev/shm (tmpfs), then /tmp, then the
% local ./scratch (created when missing).  The name: a timestamp + a
% random salt + a per-process counter, bump on a collision.  The
% counter lives in the anonymous global map (pb runs no forks, so the
% named-map limitations never apply).
opb_path() = Path =>
    Dir = tmp_dir(),
    $time(H, M, S) = datetime.current_time(),
    T = (H * 60 + M) * 60 + S,
    Map = get_global_map(),
    ( has_key(Map, pbseq) -> N0 = get(Map, pbseq) ; N0 = 0 ),
    N := N0 + 1,
    put(Map, pbseq, N),
    Base = Dir ++ "/pb_" ++ T.to_string ++ "_" ++ random2().to_string
           ++ "_" ++ N.to_string,
    ( os.exists((Base ++ ".opb").to_atom()) -> Path = Base ++ "b.opb" ; Path = Base ++ ".opb" ).

% the first candidate directory that exists and is writable
tmp_dir() = Dir =>
    ( dir_ok("/dev/shm") -> Dir = "/dev/shm"
    ; dir_ok("/tmp")     -> Dir = "/tmp"
    ;   ( os.exists("./scratch") -> true ; os.mkdir("./scratch") ),
        Dir = "./scratch"
    ).

dir_ok(D) =>
    ( os.exists(D.to_atom()) -> os.writable(D.to_atom()) ; false ).

% the constraints are stored reversed (cons order): write posted order
write_opb(N, Cs, Path) =>
    Lines = [opb_line(C) : C in Cs.reverse()],
    S = open(Path.to_atom(), write),
    println(S, "* #variable= " ++ N.to_string
               ++ " #constraint= " ++ Lines.length.to_string),
    foreach (L in Lines) println(S, L) end,
    close(S).

% roundingsat's parser wants the terms BEFORE the relation:
%   +1 x1 +1 x2 >= 1 ;
opb_line(c_card(Rel, K, Idx)) = L =>
    Ts = [ term_str(1, I) : I in Idx ],
    L = join_terms(Ts) ++ " " ++ Rel.to_string() ++ " " ++ K.to_string ++ " ;".

opb_line(c_lin(Rel, K, Terms)) = L =>
    Ts = [ term_str(C, I) : [C, I] in Terms ],
    L = join_terms(Ts) ++ " " ++ Rel.to_string() ++ " " ++ K.to_string ++ " ;".

% a signed coefficient term: "+2 x1" / "-1 x2"
term_str(C, I) = S, C < 0 =>
    S = C.to_string() ++ " x" ++ I.to_string().
term_str(C, I) = S, C >= 0 =>
    S = "+" ++ C.to_string() ++ " x" ++ I.to_string().

join_terms([T]) = T => true.
join_terms([T | Ts]) = S =>
    join_terms(Ts) = Rest,
    S = T ++ " " ++ Rest.
