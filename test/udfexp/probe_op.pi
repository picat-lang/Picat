%% probe: what does Y #= $(f(1) + f(2)) produce?
import cp.
import udf.
'#='(L,R) => cp.'#='(udf.flatten(L), udf.flatten(R)).
main =>
    udf.define($f(X), $(X * 2)),
    B :: 1..5,
    Y #= $(f(1) + f(2)),
    solve([], [B,Y]),
    println(y=Y),
    println(flat=udf.flatten($(f(1) + f(2)))),
    println(flat2=udf.flatten($(g(1) + 1))),
    udf.define($g(X), $(X + 10)).
