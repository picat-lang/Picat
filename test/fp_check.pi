%% fp_check.pi -- self-checking test for the fp module (lib2/fp.pi):
%% function composition over function-terms, mapped in one pass, and
%% the lambda extension (anonymous function values with runtime
%% evaluation, udf-style).
%%
%% Run via test/fp_check.sh.
%%
%% Checks:
%%   1. comp + map, named outer function, one pass: succ . sq = x^2+1
%%   2. comp + map, built-in outer function: '*'(2) . sq = 2*x^2
%%   3. comp of comp: succ . succ . sq
%%   4. compose (n-ary, right-to-left), incl. the empty list (identity)
%%   5. pipe (left-to-right), incl. the empty list (identity)
%%   6. comp used directly on a value (not through map)
%%   7. lambdas: call, map, 2-arg, comp of two lambdas, named call
%%   8. closures: capture, nested capture, list body, division ops
%%   9. lambda errors: arity mismatch, free variable
import fp.

sq(X) = X * X.
succ(X) = X + 1.

main =>
    A = map($comp($succ, $sq), [1,2,3]),
    check(A = [2,5,10], "comp+map named: succ . sq"),
    B = map($comp($'*'(2), $sq), [1,2,3]),
    check(B = [2,8,18], "comp+map built-in: '*'(2) . sq"),
    C = map($comp($succ, $comp($succ, $sq)), [1,2,3]),
    check(C = [3,6,11], "comp of comp: succ . succ . sq"),
    D = compose([$succ, $succ, $sq], 2),
    check(D = 6, "compose right-to-left: succ(succ(sq(2)))"),
    check(compose([], 42) = 42, "compose empty = identity"),
    E = pipe([$succ, $succ, $sq], 2),
    check(E = 16, "pipe left-to-right: sq(succ(succ(2)))"),
    check(pipe([], 42) = 42, "pipe empty = identity"),
    FC = $comp($succ, $sq),
    F = FC(5),
    check(F = 26, "comp as a value: (succ . sq)(5)"),
    FL = $lambda([X], X + 1),
    check(FL(4) = 5, "lambda call"),
    check(map($lambda([X], X * X), [1,2,3]) = [1,4,9], "lambda + map"),
    FG = $lambda([X, Y], X * Y),
    check(FG(6, 7) = 42, "2-arg lambda"),
    CL = $comp($lambda([X], X + 1), $lambda([X], X * X)),
    check(map(CL, [1,2,3]) = [2,5,10], "comp of two lambdas"),
    NL = $lambda([X], sq(X) + 1),
    check(NL(4) = 17, "lambda calls a named function"),
    MK = $lambda([X], lambda([Y], Y + X)),
    F3 = MK(3),
    check(F3(4) = 7, "closure capture"),
    GN = $lambda([X], lambda([Y], lambda([Z], X * Y + Z))),
    G1 = GN(2),
    G2 = G1(3),
    check(G2(4) = 10, "nested closures"),
    DL = $lambda([X], [X, X * X]),
    check(DL(5) = [5,25], "list body"),
    SL = $lambda([X], X / 2),
    check(SL(7) = 3.5, "real division in a lambda body"),
    IL = $lambda([X], X // 2),
    check(IL(7) = 3, "integer division in a lambda body"),
    COND = $lambda([X], cond(X > 0, X, -X)),
    check(COND(4) = 4, "lambda cond: positive branch"),
    check(COND(-4) = 4, "lambda cond: negative branch"),
    ZD = $lambda([X], cond(X == 0, 0, 100 / X)),
    check(ZD(0) = 0, "lambda cond short-circuits the untaken branch"),
    check(ZD(8) = 12.5, "lambda cond with division"),
    HT = $lambda([X], X > 3),
    check(HT(4) = true, "lambda comparison true"),
    check(HT(2) = false, "lambda comparison false"),
    check(map($lambda([X], cond(X > 2, X * X, 0)), [1,2,3,4]) = [0,0,9,16], "lambda cond + map"),
    NC = $lambda([X], cond(X > 0, cond(X > 10, 2, 1), 0)),
    check((NC(15), NC(5), NC(-1)) = (2,1,0), "nested cond"),
    AC = $lambda([X], 1 + cond(X > 0, 2, 3)),
    check((AC(4), AC(-4)) = (3,4), "cond inside arithmetic"),
    LC = $lambda([X], [cond(X > 0, 1, 0), X]),
    check((LC(4), LC(-4)) = ([1,4],[0,-4]), "cond inside a list body"),
    CC = $lambda([X], sq(cond(X > 0, 2, 3))),
    check((CC(4), CC(-4)) = (4,9), "cond inside a named call"),
    DC = $lambda([X], cond(X > 0, 1, cond(X < -5, 2, 3))),
    check((DC(1), DC(-9), DC(-1)) = (1,2,3), "chained cond in the false branch"),
    KC = $lambda([X], cond(X > 0, 5, 3) > 4),
    check((KC(4), KC(-4)) = (true,false), "cond inside a comparison"),
    MC = $lambda([X], cond(X > 2, X * X, 0) + cond(X > 3, 100, 10)),
    check((MC(4), MC(3), MC(1)) = (116,19,10), "two conds summed"),
    SQ = $lambda([X], sum(collect($sq, 1, X, $lambda([I], I*I < X)))),
    check((SQ(5), SQ(10)) = (5,14), "collect: sum of squares below X (closure condition)"),
    EL = $lambda([X], sum(collect($lambda([I], I*I), 1, X, $lambda([I], I*I < X)))),
    check((EL(5), EL(10)) = (5,14), "collect with a lambda as the map function"),
    AL = $lambda([X], sum(collect($sq, 1, X, $lambda([I], true)))),
    check(AL(4) = 30, "collect with a constant-true condition"),
    YF = $lambda([Me, N], cond(N =< 1, 1, N * selfapply(Me, N - 1))),
    check(YF(YF, 5) = 120, "recursive lambda via selfapply (factorial)"),
    ACC = $lambda([Ac, N, S], cond(N =< 0, S, selfapply(Ac, N - 1, S + N))),
    check(ACC(ACC, 10, 0) = 55, "recursive lambda with an accumulator"),
    check(truth(length([1,2,3]) == 3) = true, "truth: the expression-to-goal bridge"),
    TMB = $lambda([X], truth(X * X > 4)),
    check((TMB(3), TMB(1)) = (true,false), "truth in a lambda body"),
    check(filterf($lambda([X], X > 0), [1,-2,3,0,5]) = [1,3,5], "filterf for function values"),
    FV = $lambda([G, X], callv(G, X) + 1),
    check(FV($succ, 4) = 6, "callv applies a function value from a body"),
    catch((X = FL(3, 4), throw($no_error)), E1, true),
    check(E1 = $lambda_arity_mismatch(1, 2), "lambda arity mismatch"),
    FL2 = $lambda([X], Y + 1),
    catch((_ = FL2(1), throw($no_error)), E2, true),
    check(E2 = $lambda_free_variable(_), "lambda free variable"),
    println("ALL PASS").

check(Result, Name), Result => println("ok: " ++ Name).
check(_Result, Name) => throw($fp_check_failed(Name)).
