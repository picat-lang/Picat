% reif_globals_check.pi -- verify the reified versions of the globals
% added to lib/global_reif.pi (global_cardinality, assignment, neqs,
% notin, matrix_element, regular) against the un-reified constraints.
%
% For every constraint two checks:
%   (1) truth-value equivalence: enumerating every ground assignment,
%       the reified constraint with B = 1 accepts exactly the
%       assignments the un-reified one accepts, and with B = 0 exactly
%       the complement;
%   (2) faithfulness: on a dvar model with B unbound (solve_all), B is
%       always forced to a ground value matching the un-reified truth.
%
% Run: picat reif_globals_check.pi   (with a module that includes
% lib/global_reif.pi -- import cp2.)
import cp2.

main =>
    Fail0 = 0,
    check_gc(Fail0, Fail1),
    check_asg(Fail1, Fail2),
    check_neqs(Fail2, Fail3),
    check_notin(Fail3, Fail4),
    check_melem(Fail4, Fail5),
    check_reg(Fail5, FailN),
    ( FailN == 0 -> println("ALL PASS") ; printf("%w CHECK(S) FAILED\n",FailN), halt(1) ).

% report(Check, A, B1, B0, U, FailIn) = FailOut:  the truth-value
% equivalence:  B1 = the reified B=1 solutions,  B0 = the B=0
% solutions,  A = the un-reified solutions,  U = the whole universe.
report(Name, A, B1, B0, U, Fi, Fo) =>
    ( sort(A) == sort(B1) ->
        println(Name++" B=1: PASS")
    ;
        println(Name++" B=1: FAIL"),
        println("  un-reified: "++A.to_string()),
        println("  reified B=1: "++B1.to_string()),
        Fo1 = Fi+1
    ),
    Compl = [T : T in U, not member(T, A)],
    ( sort(Compl) == sort(B0) ->
        println(Name++" B=0: PASS"), Fo = Fi
    ;
        println(Name++" B=0: FAIL"),
        println("  complement: "++Compl.to_string()),
        println("  reified B=0: "++B0.to_string()),
        Fo = Fi+1
    ).

% ---------- global_cardinality ----------
% Xs in 1..3^3, the counts of 1 and 2 as 1 and 2.  The un-reified
% global_cardinality needs its counts as dvars (on ground counts it
% fails even for a satisfying assignment), so the truth-value
% equivalence compares the reified constraint against a pure-Picat
% truth function, and the agreement with the un-reified global is
% checked on a dvar model (dvar counts, solve_all on both).
check_gc(Fi, Fo) =>
    U = [[X1,X2,X3] : X1 in 1..3, X2 in 1..3, X3 in 1..3],
    A = [],
    foreach (T in U)
        ( gc_truth(T) == 1 -> A := A ++ [T] ; true )
    end,
    B1 = findall([X1,X2,X3], (member(X1,[1,2,3]), member(X2,[1,2,3]), member(X3,[1,2,3]),
                              global_cardinality_reif([X1,X2,X3],$[1-1, 2-2],1))),
    B0 = findall([X1,X2,X3], (member(X1,[1,2,3]), member(X2,[1,2,3]), member(X3,[1,2,3]),
                              global_cardinality_reif([X1,X2,X3],$[1-1, 2-2],0))),
    report("gc", A, B1, B0, U, Fi, Fo1),
    % the count as a dvar:  B must be forced to the gcc truth
    X1 :: 1..3, X2 :: 1..3, X3 :: 1..3, C1 :: 0..3,
    global_cardinality_reif([X1,X2,X3],$[1-C1],B),
    Sols = solve_all([X1,X2,X3,C1,B]),
    Bad = [],
    foreach (S in Sols)
        ( S[5] !== gc_truth1(S[1],S[2],S[3],S[4]) -> Bad := Bad ++ [S] ; true )
    end,
    ( Bad == [] -> println("gc dvar-count: PASS"), Fo2 = Fo1
    ; println("gc dvar-count: FAIL"), println("  bad: "++Bad.to_string()), Fo2 = Fo1+1
    ),
    % agreement with the un-reified global on a dvar model (dvar counts)
    Xu1 :: 1..3, Xu2 :: 1..3, Xu3 :: 1..3, Cu1 :: 0..3, Cu2 :: 0..3,
    global_cardinality([Xu1,Xu2,Xu3],$[1-Cu1, 2-Cu2]),
    SolsU = solve_all([Xu1,Xu2,Xu3,Cu1,Cu2]),
    Xr1 :: 1..3, Xr2 :: 1..3, Xr3 :: 1..3, Cr1 :: 0..3, Cr2 :: 0..3,
    global_cardinality_reif([Xr1,Xr2,Xr3],$[1-Cr1, 2-Cr2],Br),
    SolsR = solve_all([Xr1,Xr2,Xr3,Cr1,Cr2,Br]),
    % compare the variable parts of the B=1 solutions (with B unbound
    % the reified constraint allows both B=0 and B=1 rows, which is
    % correct:  B is the gcc truth, not a fixing of it)
    VU = sort([S.slice(1,5) : S in SolsU]),
    VR = sort([S.slice(1,5) : S in SolsR, S[6] == 1]),
    ( VU == VR -> println("gc un-reified agreement: PASS"), Fo = Fo2
    ; println("gc un-reified agreement: FAIL"),
      println("  un-reified: "++VU.to_string()),
      println("  reified: "++VR.to_string()),
      Fo = Fo2+1
    ).

% gc_truth(T):  the complete gcc reading (as bp implements it):  every
% var takes one of the keys {1,2} and the count of 1 is 1 (so the
% count of 2 is 2).
gc_truth([X1,X2,X3]) = B =>
    C1 = cond(X1==1,1,0)+cond(X2==1,1,0)+cond(X3==1,1,0),
    ( member(X1,[1,2]), member(X2,[1,2]), member(X3,[1,2]), C1 == 1 ->
        B = 1
    ; B = 0
    ).

% gc_truth1(X1,X2,X3,C1):  the complete gcc reading (as bp implements
% it) with the single pair 1-C1:  the vars must all take the key {1},
% so the count of 1 is 3 and B = 1 iff that count equals C1.
gc_truth1(X1,X2,X3,C1) = B =>
    Cnt = cond(X1==1,1,0)+cond(X2==1,1,0)+cond(X3==1,1,0),
    All1 = cond(X1==1,1,0)*cond(X2==1,1,0)*cond(X3==1,1,0),
    ( Cnt == C1, All1 == 1 -> B = 1 ; B = 0 ).

% ---------- assignment ----------
% Xs, Ys in 1..3^6:  the inverse permutations
check_asg(Fi, Fo) =>
    U = [[X1,X2,X3,Y1,Y2,Y3] : X1 in 1..3, X2 in 1..3, X3 in 1..3,
                                 Y1 in 1..3, Y2 in 1..3, Y3 in 1..3],
    A = findall([X1,X2,X3,Y1,Y2,Y3],
                (member(X1,[1,2,3]), member(X2,[1,2,3]), member(X3,[1,2,3]),
                 member(Y1,[1,2,3]), member(Y2,[1,2,3]), member(Y3,[1,2,3]),
                 assignment([X1,X2,X3],[Y1,Y2,Y3]))),
    B1 = findall([X1,X2,X3,Y1,Y2,Y3],
                 (member(X1,[1,2,3]), member(X2,[1,2,3]), member(X3,[1,2,3]),
                  member(Y1,[1,2,3]), member(Y2,[1,2,3]), member(Y3,[1,2,3]),
                  assignment_reif([X1,X2,X3],[Y1,Y2,Y3],1))),
    B0 = findall([X1,X2,X3,Y1,Y2,Y3],
                 (member(X1,[1,2,3]), member(X2,[1,2,3]), member(X3,[1,2,3]),
                  member(Y1,[1,2,3]), member(Y2,[1,2,3]), member(Y3,[1,2,3]),
                  assignment_reif([X1,X2,X3],[Y1,Y2,Y3],0))),
    report("asg", A, B1, B0, U, Fi, Fo1),
    % faithfulness on a dvar model
    X1 :: 1..3, X2 :: 1..3, X3 :: 1..3,
    Y1 :: 1..3, Y2 :: 1..3, Y3 :: 1..3,
    assignment_reif([X1,X2,X3],[Y1,Y2,Y3],B),
    Sols = solve_all([X1,X2,X3,Y1,Y2,Y3,B]),
    Bad = [],
    foreach (S in Sols)
        ( S[7] !== asg_truth(S[1..6]) -> Bad := Bad ++ [S] ; true )
    end,
    ( Bad == [] -> println("asg dvar: PASS"), Fo = Fo1
    ; println("asg dvar: FAIL"), println("  bad: "++Bad.to_string()), Fo = Fo1+1
    ).

% asg_truth(S):  1 iff L2[L1[i]] = i for every i (the inverse
% channeling).  Kept a pure expression:  a guarded multi-clause helper
% called from an expression gets inlined by cp2's udf expansion, which
% breaks its clause guards.
asg_truth([X1,X2,X3,Y1,Y2,Y3]) = B =>
    L2 = [Y1,Y2,Y3],
    B = cond(L2[X1] == 1, 1, 0) * cond(L2[X2] == 2, 1, 0) * cond(L2[X3] == 3, 1, 0).

% ---------- neqs ----------
% X, Y, Z in 1..3:  X #!= Y and Y #!= Z.  The un-reified neqs of the
% cp2 module is not comparable here (cp2 does not import common_constr,
% where check_neqs_args lives), so the truth-value equivalence
% compares against a pure-Picat truth.
check_neqs(Fi, Fo) =>
    U = [[X,Y,Z] : X in 1..3, Y in 1..3, Z in 1..3],
    A = [],
    foreach ([X,Y,Z] in U)
        ( X !== Y, Y !== Z -> A := A ++ [[X,Y,Z]] ; true )
    end,
    B1 = findall([X,Y,Z], (member(X,[1,2,3]), member(Y,[1,2,3]), member(Z,[1,2,3]),
                           neqs_reif([X #!= Y, Y #!= Z],1))),
    B0 = findall([X,Y,Z], (member(X,[1,2,3]), member(Y,[1,2,3]), member(Z,[1,2,3]),
                           neqs_reif([X #!= Y, Y #!= Z],0))),
    report("neqs", A, B1, B0, U, Fi, Fo).

% ---------- notin ----------
% X, Y in 1..5^2 outside the domain [1,3]
check_notin(Fi, Fo) =>
    U = [[X,Y] : X in 1..5, Y in 1..5],
    A = [],
    foreach ([X,Y] in U)
        ( not member(X,[1,3]), not member(Y,[1,3]) ->
            A := A ++ [[X,Y]]
        ; true
        )
    end,
    B1 = findall([X,Y], (member(X,[1,2,3,4,5]), member(Y,[1,2,3,4,5]),
                         notin_reif([X,Y],[1,3],1))),
    B0 = findall([X,Y], (member(X,[1,2,3,4,5]), member(Y,[1,2,3,4,5]),
                         notin_reif([X,Y],[1,3],0))),
    report("notin", A, B1, B0, U, Fi, Fo1),
    % faithfulness with a range domain on a dvar model
    X :: 1..10,
    notin_reif([X], 4..7, B),
    Sols = solve_all([X,B]),
    Bad = [],
    foreach (S in Sols)
        ( S[2] !== cond(member(S[1],[4,5,6,7]), 0, 1) -> Bad := Bad ++ [S] ; true )
    end,
    ( Bad == [] -> println("notin dvar: PASS"), Fo = Fo1
    ; println("notin dvar: FAIL"), println("  bad: "++Bad.to_string()), Fo = Fo1+1
    ).

% ---------- matrix_element ----------
% M = [[1,2],[3,4]], I, J in 1..2, V in 1..4.  The un-reified
% matrix_element of the cp2 module is not comparable (its check_matrix
% lives in common_constr), so the truth-value equivalence compares
% against direct indexing.
check_melem(Fi, Fo) =>
    M = new_array(2,2),
    M[1,1] = 1, M[1,2] = 2, M[2,1] = 3, M[2,2] = 4,
    U = [[I,J,V] : I in 1..2, J in 1..2, V in 1..4],
    A = [],
    foreach ([I,J,V] in U)
        ( M[I,J] == V -> A := A ++ [[I,J,V]] ; true )
    end,
    B1 = findall([I,J,V], (member(I,[1,2]), member(J,[1,2]), member(V,[1,2,3,4]),
                           matrix_element_reif(M,I,J,V,1))),
    B0 = findall([I,J,V], (member(I,[1,2]), member(J,[1,2]), member(V,[1,2,3,4]),
                           matrix_element_reif(M,I,J,V,0))),
    report("melem", A, B1, B0, U, Fi, Fo).

% ---------- regular ----------
% The DFA:  from 1: sym1->2, sym2->1 ;  from 2: sym1->2, sym2->2
% (layout M[state,symbol]);  accepting state 1.  The un-reified
% regular of the cp2 module is not comparable (its regular_constr
% lives in common_constr), so the truth-value equivalence compares
% against a pure-Picat reachability truth (reg_truth, parameterized
% by the symbol's next-state sets).
check_reg(Fi, Fo) =>
    Md = [[2,1],[2,2]],
    U = [[X] : X in 1..2],
    A = [],
    foreach ([X] in U)
        ( reg_run_truth([X], reg_dfa_nxt) == 1 -> A := A ++ [[X]] ; true )
    end,
    B1 = findall([X], (member(X,[1,2]), regular_reif([X],2,2,Md,1,[1],1))),
    B0 = findall([X], (member(X,[1,2]), regular_reif([X],2,2,Md,1,[1],0))),
    report("reg(dfa)", A, B1, B0, U, Fi, Fo1),
    % a longer DFA run (N=3)
    U3 = [[X1,X2,X3] : X1 in 1..2, X2 in 1..2, X3 in 1..2],
    A3 = [],
    foreach ([X1,X2,X3] in U3)
        ( reg_run_truth([X1,X2,X3], reg_dfa_nxt) == 1 -> A3 := A3 ++ [[X1,X2,X3]] ; true )
    end,
    B13 = findall([X1,X2,X3], (member(X1,[1,2]), member(X2,[1,2]), member(X3,[1,2]),
                               regular_reif([X1,X2,X3],2,2,Md,1,[1],1))),
    B03 = findall([X1,X2,X3], (member(X1,[1,2]), member(X2,[1,2]), member(X3,[1,2]),
                               regular_reif([X1,X2,X3],2,2,Md,1,[1],0))),
    report("reg(dfa,N=3)", A3, B13, B03, U3, Fo1, Fo2),
    % the NFA:  from 1: sym1->{1,2}, sym2->1 ;  from 2: sym1->2, sym2->1
    Mn = [[[1,2],1],[2,1]],
    An = [],
    foreach ([X] in U)
        ( reg_run_truth([X], reg_nfa_nxt) == 1 -> An := An ++ [[X]] ; true )
    end,
    B1n = findall([X], (member(X,[1,2]), regular_reif([X],2,2,Mn,1,[1],1))),
    B0n = findall([X], (member(X,[1,2]), regular_reif([X],2,2,Mn,1,[1],0))),
    report("reg(nfa)", An, B1n, B0n, U, Fo2, Fo3),
    % the NFA with a longer run (N=3)
    An3 = [],
    foreach ([X1,X2,X3] in U3)
        ( reg_run_truth([X1,X2,X3], reg_nfa_nxt) == 1 -> An3 := An3 ++ [[X1,X2,X3]] ; true )
    end,
    B1n3 = findall([X1,X2,X3], (member(X1,[1,2]), member(X2,[1,2]), member(X3,[1,2]),
                                regular_reif([X1,X2,X3],2,2,Mn,1,[1],1))),
    B0n3 = findall([X1,X2,X3], (member(X1,[1,2]), member(X2,[1,2]), member(X3,[1,2]),
                                regular_reif([X1,X2,X3],2,2,Mn,1,[1],0))),
    report("reg(nfa,N=3)", An3, B1n3, B0n3, U3, Fo3, Fo4),
    % faithfulness on a dvar model (the NFA):  B forced to the truth
    X1 :: 1..2, X2 :: 1..2, X3 :: 1..2,
    regular_reif([X1,X2,X3],2,2,Mn,1,[1],B),
    Sols = solve_all([X1,X2,X3,B]),
    Bad = [],
    foreach (S in Sols)
        ( S[4] !== reg_run_truth(S[1..3], reg_nfa_nxt) -> Bad := Bad ++ [S] ; true )
    end,
    ( Bad == [] -> println("reg dvar: PASS"), Fo = Fo4
    ; println("reg dvar: FAIL"), println("  bad: "++Bad.to_string()), Fo = Fo4+1
    ).

% reg_run_truth(L, Nxt) = B:  1 iff the automaton (next-state sets
% given by Nxt(State, Symbol)) has a run over L ending in state 1.
% Kept to pure function calls (a guarded multi-clause helper called
% from an expression gets inlined by cp2's udf expansion, which breaks
% its clause guards).
reg_run_truth(L, Nxt) = B =>
    S = reg_reach([1], L, Nxt),
    B = cond(member(1, S), 1, 0).

% reg_reach(S, L, Nxt) = R:  the states reachable from S after L.
reg_reach(S, [], _Nxt) = S.
reg_reach(S, [X|Rest], Nxt) = R =>
    S1 = sort([Y : St in S, Y in apply(Nxt, St, X)]),
    reg_reach(S1, Rest, Nxt) = R.

% the DFA's next states:  1 --1--> {2},  1 --2--> {1},  2 --1--> {2},  2 --2--> {2}
reg_dfa_nxt(_St, 1) = [2].
reg_dfa_nxt(_St, 2) = cond(_St == 1, [1], [2]).

% the NFA's next states:  1 --1--> {1,2},  1 --2--> {1},  2 --1--> {2},  2 --2--> {1}
reg_nfa_nxt(_St, 1) = cond(_St == 1, [1, 2], [2]).
reg_nfa_nxt(_St, 2) = [1].
