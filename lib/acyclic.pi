acyclic(Vs0,Es0) =>
    preproc_graph_vs_es(Vs0,Es0,Vs,Es,acyclic),
    N = len(Vs),
    TmpT is N div 2,
    (N mod 2 == 0 ->  MaxT is TmpT-1; MaxT is TmpT),
    VMap = new_map(),
    TMap = new_map(),
    foreach ({V,B} in Vs)
        VMap.put(V,B),
        T :: 0..MaxT,
        TMap.put(V,T)
    end,
    AMap = new_map(),
    EMap = new_map(),
    foreach ({V1,V2,B} in Es)
        register_edge(V1,V2,B,VMap,EMap,AMap),
        register_edge(V2,V1,B,VMap,EMap,AMap)
    end,
    ReifMap = new_map(),
    foreach ({V,B} in Vs)
        Time = TMap.get(V),
        Neibs = AMap.get(V,[]),
        K #= sum([B1 : (_,B1) in Neibs]),
        KGe2 #<=> K #>= 2,
        #~KGe2 #=> Time #= 0,
        constrain_neibs(V,Time,TMap,Neibs,ReifMap)
    end.

constrain_neibs(V,Time,TMap,[],ReifMap) => true.
constrain_neibs(V,Time,TMap,[_],ReifMap) => true.
constrain_neibs(V,Time,TMap,[(V1,B1)|L],ReifMap) =>
    Time1 = TMap.get(V1),
    Key = (V,V1),
    BGT1 #<=> Time #> Time1,
    ReifMap.put(Key,BGT1),
    RKey = (V1,V),
    if ReifMap.has_key(RKey) then
        TmpBGT = ReifMap.get(RKey),
        #~BGT1 #\/ #~TmpBGT                            % redundant but could be helpful
    end,
    constrain_neibs_aux(V,Time,BGT1,B1,TMap,L,ReifMap),
    constrain_neibs(V,Time,TMap,L,ReifMap).

constrain_neibs_aux(V,Time,BGT1,B1,TMap,[],ReifMap) => true.
constrain_neibs_aux(V,Time,BGT1,B1,TMap,[(V2,B2)|L],ReifMap) =>
    Time2 = TMap.get(V2),
    Key = (V,V2),
    BGT2 #<=> Time #> Time2,
    ReifMap.put(Key,BGT2),
    RKey = (V2,V),
    if ReifMap.has_key(RKey) then
        TmpBGT = ReifMap.get(RKey),
        #~BGT2 #\/ #~TmpBGT                            % redundant but could be helpful
    end,
    #~B1 #\/ #~B2 #\/ BGT1 #\/ BGT2,
    constrain_neibs_aux(V,Time,BGT1,B1,TMap,L,ReifMap).
    

preproc_graph_vs_es(Vs0,Es0,Vs,Es,Source) =>
    Vs1 = sort(Vs0),
    Es1 = sort(Es0),
    check_graph_vs(Vs1,VDupFlag,Source),
    (nonvar(VDupFlag) -> remove_dup_vs(Vs1,Vs); Vs = Vs1),
    check_graph_es(Es1,EDupFlag,Source),
    (nonvar(EDupFlag) -> remove_dup_es(Es1,Es); Es = Es1).

check_graph_vs([],Flag,Source) => true.
check_graph_vs([{V,B1},{V,B2}|Vs],Flag,Source) =>
    Flag = 1,
    check_graph_vertex(V,Source),
    check_graph_b(B1,Source),
    check_graph_b(B2,Source),
    check_graph_vs(Vs,Flag,Source).
check_graph_vs([{V,B}|Vs],Flag,Source) =>
    check_graph_vertex(V,Source),
    check_graph_b(B,Source),
    check_graph_vs(Vs,Flag,Source).
check_graph_vs([E|_],Flag,Source) =>
    handle_exception($pair_expected(E), Source).
check_graph_vs(Vs,Flag,Source) =>
    handle_exception($list_expected(Vs), Source).

check_graph_es([],Flag,Source) => true.
check_graph_es([{V1,V2,B1},{V1,V2,B2}|Es],Flag,Source) =>
    Flag = 1,
    check_graph_vertex(V1,Source),
    check_graph_vertex(V2,Source),    
    check_graph_b(B1,Source),
    check_graph_b(B2,Source),
    check_graph_es(Es,Flag,Source).
check_graph_es([{V1,V2,B}|Es],Flag,Source) =>
    check_graph_vertex(V1,Source),
    check_graph_vertex(V2,Source),    
    check_graph_b(B,Source),
    check_graph_es(Es,Flag,Source).
check_graph_es([E|_],Flag,Source) =>
    handle_exception($triplet_expected(E), Source).
check_graph_es(Es,Flag,Source) =>
    handle_exception($list_expected(Es), Source).

remove_dup_vs([],OVs) => OVs = [].
remove_dup_vs([Elm@{V,B1},{V,B2}|Vs],OVs) =>
    B1 = B2,
    remove_dup_vs([Elm|Vs],OVs).
remove_dup_vs([V|Vs],OVs) =>
    OVs = [V|OVsR],
    remove_dup_vs(Vs,OVsR).

remove_dup_es([],OEs) => OEs = [].
remove_dup_es([Elm@{V1,V2,B1},{V1,V2,B2}|Es],OEs) =>
    B1 = B2,
    remove_dup_es([Elm|Es],OEs).
remove_dup_es([E|Es],OEs) =>
    OEs = [E|OEsR],
    remove_dup_es(Es,OEsR).

