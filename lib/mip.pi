include "cp_sat_mip_smt.pi". % common built-ins for cp, sat, mip, and smt
include "sat_mip_smt.pi".    % common decomposers used for sat, mip, and smt
include "mip_smt.pi".        % common decomposers used for mip and smt

hcp(Vs,Es) =>
    eahc_sat(Vs, Es, mip, auto).

hcp(Vs,Es,K) =>
    K #= sum([B : {_,B} in Vs]),
    eahc_sat(Vs, Es, mip, auto).

scc(Vs,Es) =>
    graph_constrs.scc(Vs, Es, mip).

scc(Vs,Es,K) =>
    K #= sum([B : {_,B} in Vs]),
    graph_constrs.scc(Vs, Es, mip).

scc_d(Vs,Es) =>
    graph_constrs.scc_d(Vs, Es, mip).

scc_d(Vs,Es,K) =>
    K #= sum([B : {_,B} in Vs]),
    graph_constrs.scc_d(Vs, Es, mip).

tree(Vs,Es) =>
    graph_constrs.tree(Vs, Es, mip).

tree(Vs,Es,K) =>
    K #= sum([B : {_,B} in Vs]),
    graph_constrs.tree(Vs, Es, mip).

acyclic(Vs,Es) =>
    graph_constrs.acyclic(Vs, Es, mip).

acyclic(Vs,Es,K) =>
    K #= sum([B : {_,B} in Vs]),
    graph_constrs.acyclic(Vs, Es, mip).

acyclic_d(Vs,Es) =>
    graph_constrs.acyclic_d(Vs, Es, mip).

acyclic_d(Vs,Es,K) =>
    K #= sum([B : {_,B} in Vs]),
    graph_constrs.acyclic_d(Vs, Es, mip).

path(Vs,Es,Src,Dest) =>
    graph_constrs.path(Vs,Es,Src,Dest,mip).

path_d(Vs,Es,Src,Dest) =>
    graph_constrs.path_d(Vs,Es,Src,Dest,mip).

% solve(Vars) => solve(Vars).
solve(Vars) => solve([],Vars).

% solve(Options,Vars) => solve(Options,Vars)
solve(Options,Vars) =>
    mip_solve(Options, vars(Vars)).

solve_all(Vars) = solve_all([],Vars).

solve_all(Options,Vars) =
    findall(Vars, solve(Options,Vars)).

solve_once(Vs) =>
    solve_once([],Vs).

solve_once(Options,Vs) =>
    bp.global_del('$solve_once_sol',1),
    (member($min(Obj),Options) -> true; true),
    (member($max(Obj),Options) -> true; true),
    Vs1 = [Obj|Vs],
    solve_once_aux(Options,Vs1).

 solve_once_aux(Options,Vs) ?=>
    once solve(Options,Vs),
    bp.global_set('$solve_once_sol',Vs),
    fail.
solve_once_aux(Options,Vs) =>    
    bp.global_get('$solve_once_sol',Vs),
    bp.global_heap_set('$all_constrs',[]).
