include "cp_sat_mip_smt.pi". % common built-ins for cp, sat, mip, and smt
include "sat_mip_smt.pi".    % common decomposers used for sat, mip, and smt
include "mip_smt.pi".        % common decomposers used for mip and smt

hcp(Vs,Es) =>
    eahc_sat(Vs, Es, smt, auto).

hcp(Vs,Es,K) =>
    K #= sum([B : {_,B} in Vs]),
    eahc_sat(Vs, Es, smt, auto).

scc(Vs,Es) =>
    graph_constrs.scc(Vs, Es, smt).

scc(Vs,Es,K) =>
    K #= sum([B : {_,B} in Vs]),
    graph_constrs.scc(Vs, Es, smt).

scc_d(Vs,Es) =>
    graph_constrs.scc_d(Vs, Es, smt).

scc_d(Vs,Es,K) =>
    K #= sum([B : {_,B} in Vs]),
    graph_constrs.scc_d(Vs, Es, smt).

tree(Vs,Es) =>
    graph_constrs.tree(Vs, Es, smt).

tree(Vs,Es,K) =>
    K #= sum([B : {_,B} in Vs]),
    graph_constrs.tree(Vs, Es, smt).

acyclic(Vs,Es) =>
    graph_constrs.acyclic(Vs, Es, smt).

acyclic(Vs,Es,K) =>
    K #= sum([B : {_,B} in Vs]),
    graph_constrs.acyclic(Vs, Es, smt).

acyclic_d(Vs,Es) =>
    graph_constrs.acyclic_d(Vs, Es, smt).

acyclic_d(Vs,Es,K) =>
    K #= sum([B : {_,B} in Vs]),
    graph_constrs.acyclic_d(Vs, Es, smt).

path(Vs,Es,Src,Dest) =>
    graph_constrs.path(Vs,Es,Src,Dest,smt).

path_d(Vs,Es,Src,Dest) =>
    graph_constrs.path_d(Vs,Es,Src,Dest,smt).

% solve(Vars) => solve(Vars).
solve(Vars) => solve([],Vars).

% solve(Options,Vars) => solve(Options,Vars)
solve(Options,Vars) =>
    smt_solve(Options, vars(Vars)).

solve_all(Vars) = solve_all([],Vars).

solve_all(Options,Vars) =
    findall(Vars, solve(Options,Vars)).

